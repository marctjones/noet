import { Button, LineEdit, TextEdit, ComboBox, ListView, ScrollView, Palette, CheckBox } from "std-widgets.slint";
import { RichTextEditor } from "rich_editor.slint";
import { Icons } from "icons.slint";
// Brand typography — IBM Plex (OFL), the Skeptical Engineering type family.
// Chrome uses Plex Sans; the raw-source editor uses Plex Mono.
import "fonts/IBMPlexSans-Regular.ttf";
import "fonts/IBMPlexSans-SemiBold.ttf";
import "fonts/IBMPlexMono-Regular.ttf";

// Global font-zoom factor — multiplies every font size for live magnification.
export global Z {
    in-out property <float> f: 1.0;
}

// Light/dark theme — structural colors resolve from `dark`, which follows the OS
// color scheme (Palette.color-scheme) so Noet's surfaces and the built-in widgets
// stay consistent and track the system; the toggle just flips Palette.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> bg: dark ? #14161a : #eef0f3;
    out property <color> surface: dark ? #1e2127 : #ffffff;
    out property <color> surface2: dark ? #23272e : #f7f8fa;
    out property <color> surface3: dark ? #2c313a : #f1f3f6;
    out property <color> hover: dark ? #313742 : #e9ecf0;
    out property <color> sel: dark ? #1d3a37 : #e3efed;
    out property <color> text: dark ? #e7eaef : #1b2a3a;
    out property <color> text2: dark ? #aeb6c0 : #59636e;
    out property <color> text3: dark ? #79838d : #8a96a3;
    out property <color> border: dark ? #39404a : #d8dee5;
    // Restrained single accent (muted teal) — matches the Skeptical Engineering
    // "boring is a feature" feel rather than a generic bright blue.
    out property <color> accent: dark ? #6cb5ad : #2c6e68;
}

// --- Data shapes shared with Rust ---------------------------------------

export struct NoteItem {
    id: string,
    title: string,
    subtitle: string,
}

export struct FacetItem {
    name: string,   // full path (used for filtering)
    label: string,  // last segment (display)
    depth: int,     // hierarchy depth for indentation
    count: int,
    active: bool,
}

export struct TodoItem {
    id: string,
    kind: string,
    status: string,
    text: string,
    project: string,
    person: string,
    due: string,
    external: string,
    priority: string, // A/B/C
    done: bool,
}

export struct NoteRef { id: string, title: string }
// An entry in the open-notes tab strip (pinned bookmarks + recently-opened).
export struct NoteTab { id: string, title: string, pinned: bool }
// A related prior note (shared workstream/person/tag) offered for one-click linking.
export struct RelatedRef { id: string, title: string, via: string }

// A command-palette result. `id` is a typed ref the Rust side dispatches:
// "v:<view>" (open view), "n:<note-id>" (open note), "c:<command>" (run command),
// "p:<project>" / "t:<tag>" / "@:<person>" (apply a facet filter).
export struct PaletteItem { id: string, label: string, kind: string, hint: string }

export struct LicenseRow { crate-name: string, version: string, license: string }

export struct FilterChip { label: string, dim: string }

export struct CalCell {
    day: int,        // day-of-month, 0 = padding cell
    date: string,
    today: bool,
    items: [TodoItem],
}

export struct BoardColumn {
    title: string,
    key: string,
    count: int,
    cards: [TodoItem],
}

export struct GanttItem {
    id: string,
    text: string,
    date: string,
    kind: string,
    start-frac: float,
    span-frac: float,
}

export struct Segment {
    text: string,
    kind: string,   // "" plain | url | project | person | tag
    value: string,  // url to open / entity name to filter
}

export struct MdBlock {
    kind: string,   // h1/h2/h3/para/bullet/numbered/code/quote/todo/rule/typst
    text: string,
    indent: int,
    img: image,     // for kind == "typst" (compiled inline block)
    todo-id: string, // for kind == "todo" — "<note>:<line>"
    done: bool,
    status: string,  // todo / doing / done (for the read-view checkbox)
    segments: [Segment], // inline rich content (links/urls) for para/bullet
    block-id: int,   // index of the block (for heading fold toggle)
    folded: bool,    // heading is collapsed
}

// --- Reusable bits -------------------------------------------------------

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tint: #e5efff;
    in property <color> ink: #1b4d8a;
    visible: text != "";
    height: text != "" ? 18px : 0px;
    background: tint;
    border-radius: 4px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text { text: root.text; color: ink; font-size: (10px * Z.f); font-weight: 500; vertical-alignment: center; }
    }
}

// A clickable external-ref chip (URL / ref: / gh:) — opens the target in the
// browser. Same compact footprint as Chip, but hovers + clicks.
component ExtChip inherits Rectangle {
    in property <string> text;
    callback clicked;
    visible: text != "";
    height: text != "" ? 18px : 0px;
    border-radius: 4px;
    background: ec.has-hover ? #5b1b9a : #efe7fd;
    animate background { duration: 100ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 6px; padding-right: 6px; spacing: 4px;
        Image { source: Icons.external; colorize: ec.has-hover ? white : #5b1b9a; width: 12px; height: 12px; vertical-alignment: center; }
        Text { text: root.text; color: ec.has-hover ? white : #5b1b9a; font-size: (10px * Z.f); font-weight: 500; vertical-alignment: center; }
    }
    ec := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A clickable entity chip (project / person / tag) shown under a note in read view.
component LinkChip inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    in property <color> ink;
    callback clicked;
    height: 20px;
    border-radius: 5px;
    background: lc.has-hover ? ink : tint;
    animate background { duration: 100ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px;
        Text { text: root.text; color: lc.has-hover ? white : ink; font-size: (11px * Z.f); font-weight: 500; vertical-alignment: center; }
    }
    lc := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A left-nav entry (icon + label) for the NavigationView.
component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> view;
    in property <string> current;
    callback clicked;
    property <bool> active: current == view;
    height: 30px;
    border-radius: 6px;
    background: active ? Theme.sel : (nt.has-hover ? Theme.hover : transparent);
    animate background { duration: 100ms; easing: ease-out; }
    // Accessibility: also makes nav items findable/clickable from the GUI tests.
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 9px; padding-right: 6px; spacing: 9px;
        Image { source: icon; colorize: active ? Theme.accent : Theme.text2; width: 18px * Z.f; height: 18px * Z.f; vertical-alignment: center; }
        Text { text: label; font-size: (13px * Z.f); font-weight: active ? 700 : 500; color: active ? Theme.accent : Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }
    nt := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Friendly placeholder shown when a view's list is empty.
component EmptyState inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <string> hint;
    VerticalLayout {
        alignment: center;
        spacing: 7px;
        Text { text: root.glyph; font-size: (42px * Z.f); color: Theme.text3; horizontal-alignment: center; }
        Text { text: root.title; font-size: (15px * Z.f); font-weight: 600; color: Theme.text2; horizontal-alignment: center; }
        Text { text: root.hint; font-size: (12px * Z.f); color: Theme.text3; horizontal-alignment: center; wrap: word-wrap; }
    }
}

component SegBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 28px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: active ? Theme.accent : (t.has-hover ? Theme.sel : Theme.surface3);
    animate background { duration: 120ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px;
        Text {
            text: label;
            color: active ? white : Theme.text2;
            font-size: (12px * Z.f);
            font-weight: active ? 700 : 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    t := TouchArea { clicked => { root.clicked(); } }
}

component FacetRow inherits Rectangle {
    in property <string> name;
    in property <int> count;
    in property <bool> active;
    in property <int> depth: 0;
    in property <color> ink: Theme.text2;
    in property <color> hover-bg: #eef7f0;
    callback clicked;
    height: 28px;
    border-radius: 6px;
    background: active ? Theme.sel : (t.has-hover ? hover-bg : transparent);
    animate background { duration: 120ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 8px + root.depth * 14px; padding-right: 4px;
        Text {
            text: name;
            font-size: (12px * Z.f);
            color: active ? Theme.accent : Theme.text2;
            font-weight: active ? 700 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Chip { text: count; tint: #eef2f7; ink: #4a5560; }
    }
    t := TouchArea { clicked => { root.clicked(); } }
}

component KindDot inherits Rectangle {
    in property <string> kind;
    // Muted, cohesive with the restrained brand palette (still distinguishable).
    property <color> tint:
        kind == "do" ? Theme.accent :
        kind == "followup" ? #b8742e :
        kind == "delegated" ? #3a8c63 :
        kind == "todelegate" ? #7a5b9a :
        kind == "someday" ? #6b7280 :
        kind == "reading" ? #a3548a : #888;
    width: 15px; height: 15px;
    Image {
        width: 100%; height: 100%;
        colorize: root.tint;
        source:
            kind == "do" ? Icons.kind-do :
            kind == "followup" ? Icons.kind-followup :
            kind == "delegated" ? Icons.kind-delegated :
            kind == "todelegate" ? Icons.kind-todelegate :
            kind == "someday" ? Icons.kind-someday :
            kind == "reading" ? Icons.kind-reading : Icons.kind-do;
    }
}

component MiniBtn inherits Rectangle {
    in property <string> label;
    callback clicked;
    width: 22px; height: 22px; border-radius: 4px;
    background: t.has-hover ? #d9dfe7 : Theme.hover;
    animate background { duration: 100ms; easing: ease-out; }
    Text { text: label; font-size: (11px * Z.f); color: #4a5560; horizontal-alignment: center; vertical-alignment: center; }
    t := TouchArea { clicked => { root.clicked(); } }
}

component ActionButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> primary;
    in property <string> a11y: label;
    callback clicked;
    height: 30px;
    width: label == "" ? 32px : ab-content.preferred-width + 20px;
    border-radius: 5px;
    background: primary ? Theme.accent : (ab-touch.has-hover ? Theme.hover : Theme.surface3);
    border-width: 1px;
    border-color: primary ? Theme.accent : Theme.border;
    animate background { duration: 100ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: a11y;
    accessible-action-default => { root.clicked(); }
    ab-content := HorizontalLayout {
        padding-left: root.label == "" ? 0px : 9px;
        padding-right: root.label == "" ? 0px : 10px;
        spacing: 6px;
        alignment: center;
        Image {
            source: root.icon;
            colorize: root.primary ? white : Theme.text2;
            width: 15px * Z.f;
            height: 15px * Z.f;
            vertical-alignment: center;
        }
        if root.label != "": Text {
            text: root.label;
            font-size: (12px * Z.f);
            font-weight: root.primary ? 700 : 600;
            color: root.primary ? white : Theme.text;
            vertical-alignment: center;
        }
    }
    ab-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A small, discreet ✕ for the top-right corner of a pane. Position it absolutely
// (x: parent.width - self.width - 4px; y: 4px) inside the pane and wire `closed`.
component CloseX inherits Rectangle {
    callback closed();
    width: 18px; height: 18px; border-radius: 4px;
    background: cx.has-hover ? #f8d7da : transparent;
    Image {
        source: Icons.x;
        colorize: cx.has-hover ? #c82333 : Theme.text3;
        width: 13px * Z.f;
        height: 13px * Z.f;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    cx := TouchArea { clicked => { root.closed(); } }
}

// One row in the keyboard-shortcuts cheat sheet.
component KbRow inherits HorizontalLayout {
    in property <string> keys;
    in property <string> desc;
    height: 26px;
    spacing: 12px;
    Text { text: root.keys; font-size: (12px * Z.f); font-weight: 600; color: Theme.text2; width: 150px; vertical-alignment: center; }
    Text { text: root.desc; font-size: (12px * Z.f); color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;
    in property <color> accent: Theme.accent;
    height: 28px;
    spacing: 8px;
    Rectangle { width: 3px; height: 16px; y: (parent.height - self.height) / 2; border-radius: 2px; background: root.accent; }
    Text { text: root.title; font-size: (11px * Z.f); font-weight: 800; letter-spacing: 0.5px; color: Theme.text; vertical-alignment: center; }
    Text { text: root.detail; font-size: (11px * Z.f); color: Theme.text3; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
}

component MetricTile inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <color> accent: Theme.accent;
    height: 58px;
    border-radius: 7px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding-left: 10px; padding-right: 10px; padding-top: 7px; padding-bottom: 7px;
        Text { text: root.value; font-size: (19px * Z.f); font-weight: 800; color: root.accent; }
        Text { text: root.label; font-size: (10px * Z.f); color: Theme.text3; overflow: elide; }
    }
}

component NoteRow inherits Rectangle {
    in property <NoteItem> note;
    callback open(string);
    height: 44px;
    border-radius: 6px;
    background: nr.has-hover ? Theme.surface3 : transparent;
    animate background { duration: 100ms; }
    VerticalLayout {
        padding-left: 8px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px;
        Text { text: note.title; font-size: (13px * Z.f); font-weight: 650; color: Theme.text; overflow: elide; }
        Text { text: note.subtitle; font-size: (10px * Z.f); color: Theme.text3; overflow: elide; }
    }
    nr := TouchArea { mouse-cursor: pointer; clicked => { root.open(note.id); } }
}

component CommitmentRow inherits Rectangle {
    in property <TodoItem> t;
    in property <color> accent: Theme.accent;
    in property <string> action-label: "Open";
    callback cycle(string);
    callback edit(string);
    callback external(string);
    callback open(string);
    height: 62px;
    border-radius: 7px;
    background: crt.has-hover ? Theme.surface3 : transparent;
    animate background { duration: 100ms; }
    Rectangle { width: 3px; height: 100%; border-radius: 2px; background: root.accent; }
    crt := TouchArea {
        mouse-cursor: pointer;
        double-clicked => { root.open(t.id); }
    }
    HorizontalLayout {
        padding-left: 10px; padding-right: 8px; padding-top: 7px; padding-bottom: 7px;
        spacing: 9px;
        Rectangle {
            width: 20px; height: 20px; y: 2px;
            border-radius: 4px;
            border-width: 1.5px;
            border-color: (t.status == "doing" || crcb.has-hover) ? root.accent : Theme.text3;
            background: t.status == "done" ? #1f9d57 : (t.status == "doing" ? Theme.sel : Theme.surface);
            Text { text: t.status == "done" ? "✓" : (t.status == "doing" ? "•" : ""); color: t.status == "done" ? white : root.accent; font-size: (13px * Z.f); horizontal-alignment: center; vertical-alignment: center; }
            crcb := TouchArea { mouse-cursor: pointer; clicked => { root.cycle(t.id); } }
        }
        KindDot { kind: t.kind; }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: (t.priority != "" ? "[" + t.priority + "] " : "") + t.text;
                font-size: (13px * Z.f);
                font-weight: 650;
                color: t.done ? Theme.text3 : Theme.text;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 4px;
                Chip { text: t.status; tint: #eef2f7; ink: #67727d; }
                Chip { text: t.project; tint: #e7f7ec; ink: #1f7a44; }
                Chip { text: t.person; tint: #fdeede; ink: #9a5b1b; }
                Chip { text: t.due; tint: #fde7ea; ink: #9a1b33; }
                ExtChip { text: t.external; clicked => { root.external(t.external); } }
            }
        }
        Button { text: root.action-label; clicked => { root.open(t.id); } }
        Button { text: "Edit"; clicked => { root.edit(t.id); } }
    }
}

// Compact, content-sized toolbar button for the editor formatting bar.
component ToolBtn inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked;
    height: 24px;
    min-width: 26px;
    border-radius: 4px;
    background: on ? Theme.sel : (tb.has-hover ? #d9dfe7 : Theme.hover);
    animate background { duration: 100ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px;
        Text { text: label; font-size: (11px * Z.f); font-weight: 600; color: root.on ? Theme.accent : #4a5560; vertical-alignment: center; horizontal-alignment: center; }
    }
    tb := TouchArea { clicked => { root.clicked(); } }
}

// A compact todo row used by the Agenda view.
component AgendaRow inherits Rectangle {
    in property <TodoItem> t;
    callback cycle(string);
    callback edit(string);
    callback open(string);
    height: 38px;
    border-radius: 5px;
    background: ar.has-hover ? Theme.surface3 : transparent;
    animate background { duration: 100ms; }
    // Double-click the row → open its note at the todo's line (matches Tasks/Board).
    ar := TouchArea { double-clicked => { root.open(t.id); } }
    HorizontalLayout {
        padding: 6px; spacing: 8px;
        Rectangle {
            width: 18px; height: 18px; y: 2px;
            border-radius: 4px; border-width: 1.5px;
            border-color: (t.status == "doing" || cbx.has-hover) ? Theme.accent : Theme.text3;
            background: t.status == "done" ? #1f9d57 : (t.status == "doing" ? Theme.sel : white);
            Text { text: t.status == "done" ? "✓" : (t.status == "doing" ? "•" : ""); color: t.status == "done" ? white : Theme.accent; font-size: (13px * Z.f); horizontal-alignment: center; vertical-alignment: center; }
            cbx := TouchArea { mouse-cursor: pointer; clicked => { root.cycle(t.id); } }
        }
        Text {
            text: (t.priority != "" ? "[" + t.priority + "] " : "") + t.text;
            font-size: (13px * Z.f);
            color: t.done ? Theme.text3 : Theme.text;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }
        Chip { text: t.due; tint: #fde7ea; ink: #9a1b33; }
        Chip { text: t.project; tint: #e7f7ec; ink: #1f7a44; }
        MiniBtn { label: "✎"; clicked => { root.edit(t.id); } }
        MiniBtn { label: "↗"; clicked => { root.open(t.id); } }
    }
}

// A row inside a dropdown menu: leading glyph, label, optional shortcut hint,
// and a destructive (danger) variant for actions like Delete.
component MenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> shortcut;
    in property <bool> danger;
    callback clicked;
    height: 30px;
    border-radius: 5px;
    background: mt.has-hover ? (root.danger ? #e7472622 : Theme.sel) : transparent;
    animate background { duration: 90ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 9px; padding-right: 11px; spacing: 9px;
        Image {
            source: root.icon; width: 15px; height: 15px;
            colorize: root.danger ? #e74c3c : Theme.text3;
            vertical-alignment: center;
        }
        Text {
            text: root.label; font-size: (12.5px * Z.f);
            color: root.danger ? #e74c3c : Theme.text;
            vertical-alignment: center; horizontal-stretch: 1;
        }
        Text {
            text: root.shortcut; font-size: (11px * Z.f); color: Theme.text3;
            vertical-alignment: center;
        }
    }
    mt := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A thin divider between groups of menu items.
component MenuSep inherits Rectangle {
    height: 7px;
    Rectangle { height: 1px; y: 3px; background: Theme.border; }
}

// The floating dropdown panel (chrome only); items are passed as @children.
// Rendered as an in-window overlay (not a PopupWindow) so it opens instantly.
component MenuPanel inherits Rectangle {
    background: Theme.surface;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000038;
    // auto-size to the items so callers never hardcode (miscount) a height
    height: content.preferred-height;
    // absorb clicks on the panel's own padding so they don't reach the scrim
    TouchArea {}
    content := VerticalLayout {
        padding: 5px;
        @children
    }
}

// A clickable menu-bar title that opens its dropdown; auto-sizes to its label.
// A menu-bar title. Click toggles its dropdown; once ANY menu is open, hovering
// a different title switches to it instantly (classic menu-bar behavior). State
// lives in the shared `open-menu` string (two-way bound from the window).
component MenuTitle inherits Rectangle {
    in property <string> label;
    in property <string> menu-id;
    in-out property <string> open-menu;
    width: txt.preferred-width + 24px;
    height: 24px;
    border-radius: 5px;
    background: (open-menu == menu-id) ? Theme.sel : (mta.has-hover ? Theme.hover : transparent);
    txt := Text {
        text: root.label; font-size: (12.5px * Z.f);
        color: (open-menu == menu-id) ? Theme.accent : Theme.text2;
        horizontal-alignment: center; vertical-alignment: center;
    }
    mta := TouchArea {
        mouse-cursor: pointer;
        clicked => { open-menu = (open-menu == menu-id) ? "" : menu-id; }
        // hover-to-switch: if some menu is already open, hovering opens this one
        changed has-hover => {
            if (self.has-hover && open-menu != "" && open-menu != menu-id) {
                open-menu = menu-id;
            }
        }
    }
}

// A labelled field used in the todo editor form.
component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Text { text: label; font-size: (11px * Z.f); font-weight: 600; color: Theme.text2; }
    @children
}

// --- Main window ---------------------------------------------------------

export component AppWindow inherits Window {
    title: "Noet";
    default-font-family: "IBM Plex Sans"; // brand chrome font (the editor uses sred)
    // Keep the floor low so the window can shrink; the editor/content pane is
    // stretch (shrinks freely) and the fixed sidebars can be collapsed (✕).
    min-width: 480px;
    min-height: 360px;
    preferred-width: 1280px;
    preferred-height: 820px;
    background: Theme.bg;

    // Models
    in property <[NoteItem]> notes;
    in property <[FacetItem]> projects;
    in property <[FacetItem]> tags;
    in property <[FacetItem]> people;
    in property <[BoardColumn]> board-columns;
    in property <[GanttItem]> gantt-items;
    in property <[TodoItem]> tasks;
    in property <[TodoItem]> waiting-todos; // open delegated items for the Waiting view
    // Workstream hub: one workstream's open todos + the notes referencing it.
    in-out property <string> hub-name;
    in property <[TodoItem]> hub-todos;
    in property <[NoteRef]> hub-notes;
    in property <int> max-tag-count: 1;
    in property <[TodoItem]> agenda-overdue;
    in property <[TodoItem]> agenda-today;
    in property <[TodoItem]> agenda-week;
    in property <[TodoItem]> agenda-later;
    in property <[NoteItem]> inbox-notes;
    in property <[NoteRef]> current-backlinks;
    in property <[RelatedRef]> current-related; // prior notes to link this one to
    callback link-related(string);             // insert [[title]] into the editor
    in property <[TodoItem]> today-stale;
    in property <[NoteItem]> today-recent;
    in property <[NoteRef]> trash-notes;
    in property <[CalCell]> cal-cells;
    in property <string> cal-label;
    in-out property <string> capture-input;
    in-out property <bool> quick-capture-open: false; // summonable capture overlay
    in-out property <bool> show-archived: false;
    in-out property <string> selected-person;
    in property <[FilterChip]> active-filters;
    in property <[string]> smart-lists;
    in-out property <string> smartlist-input;
    in-out property <string> attach-input;
    in-out property <string> filter-kind;
    in-out property <string> filter-priority;
    in-out property <string> filter-due;
    in property <[TodoItem]> person-discuss;
    in property <[TodoItem]> person-delegated;
    in property <[TodoItem]> person-delegated-history;
    in property <[TodoItem]> person-other;
    in property <[NoteItem]> person-notes;
    in property <[NoteItem]> person-oneonone-notes;
    in property <string> person-current-oneonone-id;
    in property <string> person-current-oneonone-title;
    in-out property <string> topic-input;

    // Resizable panes (drag the dividers)
    in-out property <length> rail-width: 232px;
    in-out property <bool> nav-collapsed: false;
    in-out property <bool> rail-hidden: false;
    // Responsive: below these widths the rails auto-collapse/hide regardless of the
    // user toggle, so a narrow window stays usable (the toggle takes effect again
    // once there's room). These read `win-w` (a plain mirror of the window width,
    // pushed by `changed width` below) rather than `root.width` directly: reading
    // the laid-out width inside a property that drives a child's width/max-width
    // creates a binding loop (root.width → eff flag → child max-width →
    // layoutinfo-h → root.width). The imperative mirror breaks that cycle.
    property <length> win-w: 1280px;
    out property <bool> nav-eff-collapsed: root.nav-collapsed || root.win-w < 720px;
    out property <bool> rail-eff-hidden: root.rail-hidden || root.focus-mode || root.win-w < 860px;
    in-out property <string> open-menu: ""; // which menu-bar dropdown is open ("" = none)
    in-out property <bool> note-context-open: false;
    in-out property <string> note-context-id: "";
    in-out property <string> note-context-title: "";
    in-out property <length> note-context-x: 0px;
    in-out property <length> note-context-y: 0px;
    in-out property <length> notes-width: 280px;
    in-out property <bool> resizing: false;
    in-out property <string> resize-target;

    // View + filter state
    in-out property <string> view: "notes";
    in-out property <string> prev-view: "notes"; // the view to return to when closing a panel
    in-out property <string> note-return-view; // list to return to after a todo→note jump ("" = none)
    in-out property <bool> content-pane-open: true; // the note editor/viewer pane (reopened on select)
    // Read-only split/reference pane: a second note shown beside the editor.
    in-out property <string> split-note-id;   // "" = no split
    in property <string> split-title;
    in property <image> split-image;
    in property <length> split-doc-height;
    in-out property <length> split-width: 440px;
    callback open-in-split(string); // open a note in the reference pane
    callback close-split();         // close the reference pane
    callback edit-split();          // swap the reference note into the editor
    callback split-resized();       // re-render the reference at the new width
    in-out property <string> group-by: "status";
    in-out property <string> search;
    in-out property <string> status-filter: "";
    in-out property <string> active-summary;

    // Editor state
    in-out property <string> current-id;
    in-out property <string> current-title;
    in-out property <string> current-body;
    in property <int> current-word-count;
    in property <int> current-char-count;
    in-out property <string> status-text;
    // Focus mode: hide the menu bar, context toolbar, and both sidebars for
    // distraction-free editing (toggle in the top bar / View menu).
    in-out property <bool> focus-mode: false;
    // Command palette (Ctrl/⌘+K): fuzzy jump to notes / views / commands / facets.
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query;
    in property <[PaletteItem]> palette-results;
    // Keyboard-shortcuts cheat sheet overlay.
    in-out property <bool> shortcuts-open: false;
    // Transient toast (mirrors status-text changes; auto-clears).
    in-out property <string> toast-text;
    in-out property <bool> editing: false;
    // Plaintext/source mode: show the raw markdown in a TextEdit instead of the
    // WYSIWYG sred surface.
    in-out property <bool> source-mode: false;
    // Find / replace bar (Ctrl/⌘+F) over the sred editor.
    in-out property <bool> find-open: false;
    in-out property <string> find-query;
    in-out property <string> find-replace;
    in property <int> find-count;
    in property <int> find-current; // 1-based; 0 = none
    callback find-search(string);
    callback find-step(bool);       // true = next, false = prev
    callback find-replace-all();
    callback find-close();
    in-out property <bool> preview-on: true;
    in-out property <string> tag-input;
    in-out property <string> edit-action; // "cut"/"copy"/"paste"/"selectall" from the Edit menu
    in property <[MdBlock]> md-blocks;
    in property <bool> current-is-typst: false;
    in property <image> render-image;
    in-out property <string> current-kind: "markdown";
    in property <[string]> current-projects;
    in property <[string]> current-people;
    in property <[string]> current-tags;

    // sred WYSIWYG editor surface — the sole note editor. The frame/caret/scroll
    // props are driven by Rust (render_view) each keystroke / scroll.
    in property <image> rich-frame;
    in property <string> rich-a11y; // editor text for the accessibility tree (sred a11y snapshot)
    in property <length> rich-doc-height: 400px;
    in property <length> rich-caret-x;
    in property <length> rich-caret-y;
    in property <length> rich-caret-h: 22px;
    in-out property <length> rich-scroll-y;
    // Inline entity autocomplete (`[[` / `@[[` / `#`) — driven by Rust.
    in-out property <[string]> rich-ac-items;
    in-out property <int> rich-ac-index;
    in-out property <bool> rich-ac-open;

    // Todo editor form state
    in-out property <bool> form-visible: false;
    in-out property <bool> form-is-new: true;
    in-out property <string> form-id;
    in-out property <string> form-text;
    in-out property <string> form-kind: "do";
    in-out property <string> form-status: "todo";
    in-out property <string> form-person;
    in-out property <string> form-project;
    in-out property <string> form-start;
    in-out property <string> form-due;
    in-out property <string> form-external;
    in-out property <string> form-priority;
    in-out property <string> form-repeat;
    in-out property <bool> form-show-details: false;

    // Settings view: paths shown read-only; vault-input is the editable field.
    in-out property <string> vault-path;
    in-out property <string> index-path;
    in-out property <string> settings-path;
    in-out property <string> vault-input;
    in-out property <bool> launch-on-startup;          // registered to run at login
    in property <bool> launch-on-startup-supported;    // only wired on Windows today
    // About / open-source licenses view.
    in-out property <string> app-version;
    in-out property <[LicenseRow]> license-rows;
    in-out property <string> license-summary;

    // Callbacks
    callback quit();
    callback note-title-edited(string);
    callback save-settings(string); // persist a new vault path
    callback open-external(string); // open a URL/ref in the browser
    callback open-licenses(); // open the full third-party license notices
    callback open-vault-folder(); // open the vault folder in the file manager
    callback set-launch-on-startup(bool); // register/unregister launch at login
    callback export-note(string); // format: "md" | "pdf"
    callback reindex-finished();
    callback new-note();
    callback select-note(string);
    in property <[NoteTab]> note-tabs;   // open-notes tab strip (pinned + recent)
    callback pin-note(string);           // toggle a note's pinned bookmark
    callback close-tab(string);          // drop a note from the tab strip
    callback delete-note-id(string);     // move a specific note to trash
    callback archive-note-id(string, bool);
    callback save-note(string, string, string);
    callback reindex();
    callback toggle-todo(string);
    callback set-view(string);
    callback set-group-by(string);
    callback set-search(string);
    callback set-status-filter(string);
    callback toggle-project(string);
    callback toggle-tag(string);
    callback toggle-person(string);
    callback clear-filters();
    callback board-move(string, int);
    callback open-note(string);
    callback drop-card(string /*todo id*/, string /*column key*/);
    callback open-add-todo();
    callback edit-todo(string);
    callback save-todo();
    callback add-tag(string);
    callback note-edited();
    callback set-source-mode(bool); // switched plaintext/WYSIWYG; reload sred on return
    callback stop-editing();
    // Command palette
    callback palette-search(string);   // query changed → repopulate palette-results
    callback palette-activate(string); // an item's id was chosen
    // sred editor wiring — forwarded into the sred Editor on the Rust side.
    callback rich-insert-text(string);    // a typed character / newline
    callback rich-chord(string) -> bool;  // a Ctrl-chord (bold/copy/undo/…)
    callback rich-special(string);        // backspace/arrows/home/end/…
    callback rich-pointer-down(length, length);
    callback rich-pointer-drag(length, length);
    callback rich-pointer-double(length, length);
    callback rich-resized(length, length);
    callback rich-scrolled(length);       // wheel/scrollbar → re-render the slice
    callback rich-ac-key(string);         // autocomplete nav/accept/dismiss
    callback rich-ac-pick(int);           // autocomplete row clicked
    callback rich-insert(string);         // insert a snippet (entity-picker tokens)
    callback rich-copy();                 // copy the sred selection to the clipboard
    callback toggle-kind();
    callback set-clip(string);
    callback selection-to-todo();
    callback selection-to-note();
    callback cycle-todo(string);
    callback quick-capture(string);
    callback archive-note(bool);
    callback set-show-archived(bool);
    callback pick-person(string);
    callback new-related-note();
    callback add-link(string);
    callback open-url(string);
    callback toggle-fold(int);
    callback set-kind-filter(string);
    callback set-priority-filter(string);
    callback set-due-filter(string);
    callback clear-filter(string);
    callback new-from-template(string);
    callback delete-note();
    callback restore-note(string);
    callback apply-smart-list(string);
    callback save-smart-list(string);
    callback delete-smart-list(string);
    callback attach-path(string);
    callback cal-prev();
    callback cal-next();
    callback cal-today();

    // Mirror the laid-out window width into a plain property (see `win-w` above).
    // This is a one-way imperative push, so the responsive breakpoints can read it
    // without forming a layout binding loop.
    changed width => { root.win-w = root.width; }

    // The sred editor renders to a bitmap (not reactive to Theme), so re-render it
    // when the color scheme flips — at OS-scheme detection on launch *and* on the
    // manual light/dark toggle — otherwise the editor keeps a stale light/dark frame.
    out property <bool> is-dark: Theme.dark;
    callback theme-changed();
    changed is-dark => { root.theme-changed(); }

    // Surface status messages as a transient toast (auto-clears via the timer below).
    changed source-mode => { root.set-source-mode(root.source-mode); }
    changed status-text => {
        if (root.status-text != "") {
            root.toast-text = root.status-text;
            toast-timer.running = false;
            toast-timer.running = true;
        }
    }

    Rectangle {
        VerticalLayout {
            // ===== Menu bar =====
            Rectangle {
                height: root.focus-mode ? 0px : 30px;
                visible: !root.focus-mode;
                background: Theme.surface2;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    alignment: start;
                    padding-left: 6px;
                    padding-top: 3px;
                    spacing: 2px;

                    fileTitle := MenuTitle { label: "File"; menu-id: "file"; open-menu <=> root.open-menu; }
                    editTitle := MenuTitle { label: "Edit"; menu-id: "edit"; open-menu <=> root.open-menu; }
                    noteTitle := MenuTitle { label: "Note"; menu-id: "note"; open-menu <=> root.open-menu; }
                    viewTitle := MenuTitle { label: "View"; menu-id: "view"; open-menu <=> root.open-menu; }
                    helpTitle := MenuTitle { label: "Help"; menu-id: "help"; open-menu <=> root.open-menu; }
                }
            }

            // ===== Top bar =====
            Rectangle {
                height: 52px;
                background: Theme.surface;
                HorizontalLayout {
                    padding: 9px;
                    spacing: 9px;
                    Image { source: Icons.noet-mark; colorize: Theme.accent; width: 22px * Z.f; height: 22px * Z.f; vertical-alignment: center; }
                    Text { text: "Noet"; font-size: (19px * Z.f); font-weight: 700; color: Theme.text; vertical-alignment: center; }
                    LineEdit {
                        placeholder-text: "Search notes & todos…";
                        text <=> root.search;
                        horizontal-stretch: 1;
                        edited(t) => { root.set-search(t); }
                    }
                    ActionButton { icon: Icons.keyboard; label: "Go to…"; a11y: "Command palette"; clicked => { root.palette-query = ""; root.palette-search(""); root.palette-open = true; } }
                    ActionButton { icon: Icons.focus; label: root.focus-mode ? "Exit focus" : "Focus"; clicked => { root.focus-mode = !root.focus-mode; } }
                    ActionButton { icon: Icons.plus; label: "New note"; primary: true; clicked => { root.new-note(); } }
                    ActionButton { icon: Icons.refresh; label: ""; a11y: "Reindex"; clicked => { root.reindex(); } }
                    Button { text: "A−"; clicked => { Z.f = max(Z.f - 0.1, 0.6); } }
                    Button { text: "A＋"; clicked => { Z.f = min(Z.f + 0.1, 2.5); } }
                    // Shows the current text zoom; click to reset to 100%.
                    Button { text: Math.round(Z.f * 100) + "%"; clicked => { Z.f = 1.0; } }
                    ActionButton {
                        icon: Theme.dark ? Icons.sun : Icons.moon;
                        label: "";
                        a11y: Theme.dark ? "Light theme" : "Dark theme";
                        clicked => {
                            Palette.color-scheme = Theme.dark ? ColorScheme.light : ColorScheme.dark;
                        }
                    }
                }
            }

            // ===== Context toolbar (per-view actions) =====
            if (!root.focus-mode && (root.view == "today" || root.view == "notes" || root.view == "tasks"
                || root.view == "agenda" || root.view == "gantt" || root.view == "inbox"
                || root.view == "board" || root.view == "calendar"
                || root.view == "labels" || root.view == "people")): Rectangle {
                height: 40px;
                background: Theme.surface2;
                Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.border; }
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; padding-top: 5px; padding-bottom: 5px; spacing: 6px;
                    alignment: start;
                    if (root.view == "today"): ActionButton { icon: Icons.plus; label: "Capture"; clicked => { root.set-view("inbox"); } }
                    if (root.view == "today"): ActionButton { icon: Icons.refresh; label: "Refresh"; clicked => { root.reindex(); } }
                    // After jumping to a note from a todo, offer a one-click return
                    // to the list (Tasks/Board/Today/…) you came from.
                    if (root.view == "notes" && root.note-return-view != ""): Button {
                        text: "← Back to " + (
                            root.note-return-view == "tasks" ? "Tasks" :
                            root.note-return-view == "board" ? "Board" :
                            root.note-return-view == "today" ? "Today" :
                            root.note-return-view == "agenda" ? "Agenda" :
                            root.note-return-view == "people" ? "People" :
                            root.note-return-view == "gantt" ? "Gantt" :
                            root.note-return-view == "calendar" ? "Calendar" : "list");
                        clicked => { root.set-view(root.note-return-view); }
                    }
                    if (root.view == "notes"): ActionButton { icon: Icons.branch; label: "Related note"; clicked => { root.new-related-note(); } }
                    if (root.view == "notes"): ActionButton { icon: Icons.check; label: "Add todo"; clicked => { root.open-add-todo(); } }
                    if (root.view == "notes"): ActionButton { icon: Icons.download; label: "Export PDF"; clicked => { root.export-note("pdf"); } }
                    if (root.view == "tasks" || root.view == "agenda" || root.view == "gantt"): ActionButton { icon: Icons.check; label: "Add todo"; clicked => { root.open-add-todo(); } }
                    if (root.view == "inbox"): ActionButton { icon: Icons.plus; label: "New note"; primary: true; clicked => { root.new-note(); } }
                    Rectangle { horizontal-stretch: 1; }
                    if (root.active-summary != ""): Text { text: root.active-summary; font-size: (11px * Z.f); color: Theme.text3; vertical-alignment: center; }
                    // Close this view (back to the previously open view).
                    CloseX { closed => { root.set-view(root.prev-view); } }
                }
            }

            // ===== Body =====
            HorizontalLayout {
                // ----- Navigation rail (Win11 NavigationView) -----
                Rectangle {
                    width: root.focus-mode ? 0px : (root.nav-eff-collapsed ? 52px : 168px);
                    visible: !root.focus-mode;
                    animate width { duration: 140ms; easing: ease-out; }
                    background: Theme.surface;
                    Rectangle {
                        x: parent.width - 1px; width: 1px; height: 100%;
                        background: Theme.border;
                    }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 1px;
                        // Collapse / expand toggle
                        NavItem {
                            icon: Icons.collapse; label: "Collapse"; view: "__toggle"; current: "";
                            clicked => { root.nav-collapsed = !root.nav-collapsed; }
                        }
                        if !root.nav-eff-collapsed : Text { text: "PLAN"; font-size: (9px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                        Rectangle { height: root.nav-eff-collapsed ? 4px : 0px; }
                        NavItem { icon: Icons.today; label: "Today"; view: "today"; current: root.view; clicked => { root.set-view("today"); } }
                        NavItem { icon: Icons.agenda; label: "Agenda"; view: "agenda"; current: root.view; clicked => { root.set-view("agenda"); } }
                        NavItem { icon: Icons.calendar; label: "Calendar"; view: "calendar"; current: root.view; clicked => { root.set-view("calendar"); } }
                        if !root.nav-eff-collapsed : Text { text: "WORK"; font-size: (9px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                        Rectangle { height: root.nav-eff-collapsed ? 4px : 0px; }
                        NavItem { icon: Icons.tasks; label: "Tasks"; view: "tasks"; current: root.view; clicked => { root.set-view("tasks"); } }
                        NavItem { icon: Icons.board; label: "Board"; view: "board"; current: root.view; clicked => { root.set-view("board"); } }
                        NavItem { icon: Icons.gantt; label: "Gantt"; view: "gantt"; current: root.view; clicked => { root.set-view("gantt"); } }
                        NavItem { icon: Icons.kind-delegated; label: "Waiting"; view: "waiting"; current: root.view; clicked => { root.set-view("waiting"); } }
                        if !root.nav-eff-collapsed : Text { text: "NOTES"; font-size: (9px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                        Rectangle { height: root.nav-eff-collapsed ? 4px : 0px; }
                        NavItem { icon: Icons.notes; label: "Notes"; view: "notes"; current: root.view; clicked => { root.set-view("notes"); } }
                        NavItem { icon: Icons.inbox; label: "Inbox"; view: "inbox"; current: root.view; clicked => { root.set-view("inbox"); } }
                        if !root.nav-eff-collapsed : Text { text: "ORGANIZE"; font-size: (9px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                        Rectangle { height: root.nav-eff-collapsed ? 4px : 0px; }
                        NavItem { icon: Icons.people; label: "People"; view: "people"; current: root.view; clicked => { root.set-view("people"); } }
                        NavItem { icon: Icons.labels; label: "Labels"; view: "labels"; current: root.view; clicked => { root.set-view("labels"); } }
                        Rectangle { vertical-stretch: 1; }
                        // App-level settings, pinned to the bottom (Win11 pattern).
                        NavItem { icon: Icons.settings; label: "Settings"; view: "settings"; current: root.view; clicked => { root.set-view("settings"); } }
                    }
                }
                // ----- Filter rail -----
                Rectangle {
                    visible: !root.rail-eff-hidden;
                    // preferred width (resizable) but min 0 so it compresses on a
                    // narrow window instead of forcing a large minimum window size.
                    preferred-width: root.rail-eff-hidden ? 0px : root.rail-width;
                    min-width: 0px;
                    max-width: root.rail-eff-hidden ? 0px : root.rail-width;
                    clip: true;
                    background: Theme.surface2;
                    Rectangle {
                        x: parent.width - 4px; width: 7px; height: 100%;
                        background: (rh.has-hover || rh.pressed) ? #c8d0d9 : transparent;
                        rh := TouchArea {
                            mouse-cursor: ew-resize;
                            property <length> sw;
                            property <length> sx;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) { self.sw = root.rail-width; self.sx = self.absolute-position.x + self.mouse-x; }
                            }
                            moved => { root.rail-width = clamp(self.sw + (self.absolute-position.x + self.mouse-x - self.sx), 150px, 480px); }
                        }
                    }
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            Text { text: "FILTERS"; font-size: (10px * Z.f); letter-spacing: 1px; color: Theme.text3; vertical-alignment: center; horizontal-stretch: 1; }
                            CloseX { closed => { root.rail-hidden = true; } } // reopen via View ▸ Show filter rail
                        }
                        Text { text: "STATUS"; font-size: (10px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                        HorizontalLayout {
                            spacing: 4px;
                            SegBtn { label: "All"; active: root.status-filter == ""; clicked => { root.set-status-filter(""); } }
                            SegBtn { label: "Open"; active: root.status-filter == "open"; clicked => { root.set-status-filter("open"); } }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            SegBtn { label: "To Do"; active: root.status-filter == "todo"; clicked => { root.set-status-filter("todo"); } }
                            SegBtn { label: "Doing"; active: root.status-filter == "doing"; clicked => { root.set-status-filter("doing"); } }
                            SegBtn { label: "Done"; active: root.status-filter == "done"; clicked => { root.set-status-filter("done"); } }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "KIND"; font-size: (10px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                                ComboBox {
                                    model: ["any", "do", "followup", "delegated", "todelegate", "someday", "reading"];
                                    current-value <=> root.filter-kind;
                                    selected(v) => { root.set-kind-filter(v); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "PRIORITY"; font-size: (10px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                                ComboBox { model: ["any", "A", "B", "C"]; current-value <=> root.filter-priority; selected(v) => { root.set-priority-filter(v); } }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "DUE"; font-size: (10px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                                ComboBox { model: ["any", "overdue", "this week", "has date", "no date"]; current-value <=> root.filter-due; selected(v) => { root.set-due-filter(v); } }
                            }
                        }

                        if (root.active-filters.length > 0): VerticalLayout {
                            spacing: 3px;
                            Text { text: "ACTIVE FILTERS"; font-size: (10px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                            for fc in root.active-filters: Rectangle {
                                height: 22px; border-radius: 5px;
                                background: afc.has-hover ? #fde7ea : #eef2f7;
                                animate background { duration: 100ms; }
                                HorizontalLayout {
                                    padding-left: 7px; padding-right: 6px; spacing: 4px;
                                    Text { text: fc.label; font-size: (11px * Z.f); color: #4a5560; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: "✕"; font-size: (11px * Z.f); color: afc.has-hover ? #c82333 : Theme.text3; vertical-alignment: center; }
                                }
                                afc := TouchArea { mouse-cursor: pointer; clicked => { root.clear-filter(fc.dim); } }
                            }
                        }

                        if (root.smart-lists.length > 0): VerticalLayout {
                            spacing: 2px;
                            Text { text: "SMART LISTS"; font-size: (10px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                            for sl in root.smart-lists: Rectangle {
                                height: 26px; border-radius: 5px;
                                background: slt.has-hover ? Theme.sel : transparent;
                                animate background { duration: 100ms; }
                                slt := TouchArea { clicked => { root.apply-smart-list(sl); } }
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 4px; spacing: 4px;
                                    Text { text: "★ " + sl; font-size: (12px * Z.f); color: Theme.accent; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Rectangle {
                                        width: 18px;
                                        Text { text: "✕"; font-size: (11px * Z.f); color: slx.has-hover ? #c82333 : Theme.text3; horizontal-alignment: center; vertical-alignment: center; }
                                        slx := TouchArea { clicked => { root.delete-smart-list(sl); } }
                                    }
                                }
                            }
                        }

                        Text { text: "WORKSTREAMS"; font-size: (10px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                        Rectangle {
                            vertical-stretch: 1;
                            ListView {
                                for p in root.projects: FacetRow {
                                    name: "▸ " + p.label;
                                    depth: p.depth;
                                    count: p.count;
                                    active: p.active;
                                    ink: #2a7a4a;
                                    hover-bg: #eef7f0;
                                    clicked => { root.toggle-project(p.name); }
                                }
                            }
                        }

                        Text { text: "TAGS"; font-size: (10px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                        Rectangle {
                            height: 100px;
                            ListView {
                                for t in root.tags: FacetRow {
                                    name: "# " + t.label;
                                    depth: t.depth;
                                    count: t.count;
                                    active: t.active;
                                    ink: #5b1b9a;
                                    hover-bg: #f3ecfb;
                                    clicked => { root.toggle-tag(t.name); }
                                }
                            }
                        }

                        Text { text: "PEOPLE"; font-size: (10px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                        Rectangle {
                            height: 100px;
                            ListView {
                                for p in root.people: FacetRow {
                                    name: "@ " + p.name;
                                    count: p.count;
                                    active: p.active;
                                    ink: #9a5b1b;
                                    hover-bg: #fdf2e6;
                                    clicked => { root.toggle-person(p.name); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            LineEdit { placeholder-text: "save filter as…"; text <=> root.smartlist-input; horizontal-stretch: 1; accepted => { root.save-smart-list(root.smartlist-input); } }
                            ActionButton { icon: Icons.save; label: ""; a11y: "Save filter"; clicked => { root.save-smart-list(root.smartlist-input); } }
                        }
                        ActionButton { icon: Icons.filter-x; label: "Clear filters"; clicked => { root.clear-filters(); } }
                    }
                }

                // ----- NOTES view -----
                if (root.view == "notes"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        listpane := Rectangle {
                            property <bool> open: true;
                            // preferred width (resizable) but min 0 so it compresses
                            // when the window is narrow instead of blocking the resize.
                            preferred-width: listpane.open ? root.notes-width : 30px;
                            min-width: listpane.open ? 0px : 30px;
                            max-width: listpane.open ? root.notes-width : 30px;
                            background: Theme.surface2;
                            border-radius: 8px;
                            clip: true;
                            // Collapsed: a thin strip; click to reopen.
                            if (!listpane.open): TouchArea {
                                mouse-cursor: pointer;
                                clicked => { listpane.open = true; }
                                Text { text: "▸"; font-size: (14px * Z.f); color: Theme.text3; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if (listpane.open): Rectangle {
                                x: parent.width - 3px; width: 7px; height: 100%;
                                background: (nh.has-hover || nh.pressed) ? #c8d0d9 : transparent;
                                nh := TouchArea {
                                    mouse-cursor: ew-resize;
                                    property <length> sw;
                                    property <length> sx;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) { self.sw = root.notes-width; self.sx = self.absolute-position.x + self.mouse-x; }
                                    }
                                    moved => { root.notes-width = clamp(self.sw + (self.absolute-position.x + self.mouse-x - self.sx), 180px, 680px); }
                                }
                            }
                            if (listpane.open): VerticalLayout {
                                padding: 8px;
                                HorizontalLayout {
                                    Text { text: "NOTES (" + root.notes.length + ")"; font-size: (10px * Z.f); letter-spacing: 1px; color: Theme.text3; vertical-alignment: center; horizontal-stretch: 1; }
                                    CloseX { closed => { listpane.open = false; } }
                                }
                                Rectangle {
                                  vertical-stretch: 1;
                                  if root.notes.length == 0 : EmptyState {
                                      glyph: "▢";
                                      title: "No notes here";
                                      hint: "Press ＋ New note above, or clear filters to see everything.";
                                  }
                                  ListView {
                                    for n in root.notes: Rectangle {
                                        height: 48px;
                                        border-radius: 6px;
                                        background: n.id == root.current-id ? Theme.sel : (nt.has-hover ? Theme.hover : transparent);
                                        animate background { duration: 120ms; easing: ease-out; }
                                        Rectangle { x: 0; width: 3px; border-radius: 2px; background: Theme.accent; visible: n.id == root.current-id; }
                                        VerticalLayout {
                                            padding: 6px;
                                            Text { text: n.title; font-size: (13px * Z.f); font-weight: 600; color: Theme.text; overflow: elide; }
                                            Text { text: n.subtitle; font-size: (10px * Z.f); color: Theme.text3; overflow: elide; }
                                        }
                                        nt := TouchArea {
                                            clicked => { root.select-note(n.id); }
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                                    root.note-context-id = n.id;
                                                    root.note-context-title = n.title;
                                                    root.note-context-x = min(self.absolute-position.x + self.mouse-x, root.width - 246px);
                                                    root.note-context-y = min(self.absolute-position.y + self.mouse-y, root.height - 220px);
                                                    root.note-context-open = true;
                                                }
                                            }
                                        }
                                    }
                                  }
                                }
                            }
                        }
                        contentpane := Rectangle {
                            horizontal-stretch: root.content-pane-open ? 1 : 0;
                            min-width: root.content-pane-open ? 0px : 30px;
                            max-width: root.content-pane-open ? 100000px : 30px;
                            background: Theme.surface;
                            border-radius: 8px;
                            clip: true;
                            // Collapsed: a thin strip; click to reopen.
                            if (!root.content-pane-open): TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.content-pane-open = true; }
                                Text { text: "◂"; font-size: (14px * Z.f); color: Theme.text3; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if (root.content-pane-open): VerticalLayout {
                                padding: 12px;
                                spacing: 8px;

                                // Open-notes tab strip (pinned bookmarks + recents) + pane close.
                                HorizontalLayout {
                                    spacing: 4px;
                                    Flickable {
                                        horizontal-stretch: 1;
                                        height: 26px;
                                        viewport-width: tabrow.preferred-width;
                                        tabrow := HorizontalLayout {
                                            spacing: 4px;
                                            for tab in root.note-tabs: Rectangle {
                                                height: 24px;
                                                border-radius: 5px;
                                                background: tab.id == root.current-id ? Theme.sel : (tabta.has-hover ? Theme.hover : Theme.surface2);
                                                border-width: 1px;
                                                border-color: tab.id == root.current-id ? Theme.accent : transparent;
                                                // Row click selects; the pin/close TouchAreas sit on top of it.
                                                tabta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.select-note(tab.id); }
                                                    pointer-event(e) => {
                                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                                            root.note-context-id = tab.id;
                                                            root.note-context-title = tab.title;
                                                            root.note-context-x = min(self.absolute-position.x + self.mouse-x, root.width - 246px);
                                                            root.note-context-y = min(self.absolute-position.y + self.mouse-y, root.height - 220px);
                                                            root.note-context-open = true;
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 6px; padding-right: 4px; spacing: 3px;
                                                    pinta := TouchArea {
                                                        width: 14px; mouse-cursor: pointer;
                                                        Image {
                                                            source: Icons.star;
                                                            colorize: tab.pinned ? Theme.accent : Theme.text3;
                                                            width: 12px * Z.f;
                                                            height: 12px * Z.f;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                        }
                                                        clicked => { root.pin-note(tab.id); }
                                                    }
                                                    Text { text: tab.title; font-size: (12px * Z.f); color: Theme.text; vertical-alignment: center; overflow: elide; max-width: 130px; }
                                                    splitta := TouchArea {
                                                        width: 14px; mouse-cursor: pointer;
                                                        Image {
                                                            source: Icons.panel-right;
                                                            colorize: splitta.has-hover ? Theme.accent : Theme.text3;
                                                            width: 12px * Z.f;
                                                            height: 12px * Z.f;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                        }
                                                        clicked => { root.open-in-split(tab.id); }
                                                    }
                                                    closeta := TouchArea {
                                                        width: 14px; mouse-cursor: pointer;
                                                        Image {
                                                            source: Icons.x;
                                                            colorize: closeta.has-hover ? Theme.text : Theme.text3;
                                                            width: 11px * Z.f;
                                                            height: 11px * Z.f;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                        }
                                                        clicked => { root.close-tab(tab.id); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CloseX { closed => { root.content-pane-open = false; } }
                                }

                                // ---- The note editor (always shown — single surface) ----
                                editpane := VerticalLayout {
                                    spacing: 8px;
                                    // Insert a snippet / copy the selection through the sred editor.
                                    function snip(s: string) { root.rich-insert(s); }
                                    function copysel() { root.rich-copy(); }
                                    // Edit-menu actions (Ctrl+X/C/V/A) routed into the sred editor.
                                    property <string> ea: root.edit-action;
                                    changed ea => {
                                        if (self.ea == "cut") { root.rich-chord("x"); }
                                        if (self.ea == "copy") { root.rich-chord("c"); }
                                        if (self.ea == "paste") { root.rich-chord("v"); }
                                        if (self.ea == "selectall") { root.rich-chord("a"); }
                                        if (self.ea != "") { root.edit-action = ""; }
                                    }
                                    // formatting + selection toolbar (WYSIWYG only — its buttons
                                    // act on the sred buffer; min-width 0 so the wide row doesn't
                                    // floor the pane width; overflow clips in the content pane)
                                    if (!root.source-mode): HorizontalLayout {
                                        spacing: 4px;
                                        min-width: 0px;
                                        ToolBtn { label: "B"; clicked => { editpane.snip("**bold**"); } }
                                        ToolBtn { label: "I"; clicked => { editpane.snip("*italic*"); } }
                                        ToolBtn { label: "H1"; clicked => { editpane.snip("\n# Heading\n"); } }
                                        ToolBtn { label: "H2"; clicked => { editpane.snip("\n## Heading\n"); } }
                                        ToolBtn { label: "•"; clicked => { editpane.snip("\n- item"); } }
                                        ToolBtn { label: "1."; clicked => { editpane.snip("\n1. item"); } }
                                        ToolBtn { label: "</>"; clicked => { editpane.snip("`code`"); } }
                                        ToolBtn { label: "“ ”"; clicked => { editpane.snip("\n> quote"); } }
                                        ToolBtn { label: "{typ}"; clicked => { editpane.snip("\n```typst\n\n```\n"); } }
                                        Rectangle { width: 8px; }
                                        // entity pickers — insert an existing workstream / person / label
                                        Rectangle {
                                            width: 34px; height: 24px; border-radius: 4px;
                                            background: wspick.has-hover ? #d9dfe7 : Theme.hover;
                                            Text { text: "[[ ]]"; font-size: (11px * Z.f); font-weight: 600; color: #1f7a44; horizontal-alignment: center; vertical-alignment: center; }
                                            wsPick := PopupWindow {
                                                x: 0; y: 26px; width: 210px; height: 250px;
                                                Rectangle {
                                                    background: Theme.surface; border-radius: 8px;
                                                    drop-shadow-blur: 10px; drop-shadow-color: #0000001f;
                                                    VerticalLayout {
                                                        padding: 4px;
                                                        Text { text: "WORKSTREAMS"; font-size: (9px * Z.f); letter-spacing: 0.5px; color: Theme.text3; }
                                                        ListView {
                                                            for p in root.projects: MenuItem {
                                                                label: "▸ " + p.name;
                                                                clicked => { editpane.snip("[[" + p.name + "]]"); wsPick.close(); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            wspick := TouchArea { clicked => { wsPick.show(); } }
                                        }
                                        Rectangle {
                                            width: 26px; height: 24px; border-radius: 4px;
                                            background: perpick.has-hover ? #d9dfe7 : Theme.hover;
                                            Text { text: "@"; font-size: (12px * Z.f); font-weight: 600; color: #9a5b1b; horizontal-alignment: center; vertical-alignment: center; }
                                            perPick := PopupWindow {
                                                x: 0; y: 26px; width: 210px; height: 250px;
                                                Rectangle {
                                                    background: Theme.surface; border-radius: 8px;
                                                    drop-shadow-blur: 10px; drop-shadow-color: #0000001f;
                                                    VerticalLayout {
                                                        padding: 4px;
                                                        Text { text: "PEOPLE"; font-size: (9px * Z.f); letter-spacing: 0.5px; color: Theme.text3; }
                                                        ListView {
                                                            for p in root.people: MenuItem {
                                                                label: "@ " + p.name;
                                                                clicked => { editpane.snip("@[[" + p.name + "]]"); perPick.close(); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            perpick := TouchArea { clicked => { perPick.show(); } }
                                        }
                                        Rectangle {
                                            width: 26px; height: 24px; border-radius: 4px;
                                            background: tagpick.has-hover ? #d9dfe7 : Theme.hover;
                                            Text { text: "#"; font-size: (12px * Z.f); font-weight: 600; color: #5b1b9a; horizontal-alignment: center; vertical-alignment: center; }
                                            tagPick := PopupWindow {
                                                x: 0; y: 26px; width: 210px; height: 250px;
                                                Rectangle {
                                                    background: Theme.surface; border-radius: 8px;
                                                    drop-shadow-blur: 10px; drop-shadow-color: #0000001f;
                                                    VerticalLayout {
                                                        padding: 4px;
                                                        Text { text: "LABELS"; font-size: (9px * Z.f); letter-spacing: 0.5px; color: Theme.text3; }
                                                        ListView {
                                                            for p in root.tags: MenuItem {
                                                                label: "# " + p.name;
                                                                clicked => { editpane.snip("#" + p.name + " "); tagPick.close(); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            tagpick := TouchArea { clicked => { tagPick.show(); } }
                                        }
                                        Rectangle { width: 8px; }
                                        ToolBtn { label: "Todo"; clicked => { editpane.copysel(); root.selection-to-todo(); } }
                                        ToolBtn { label: "Note"; clicked => { editpane.copysel(); root.selection-to-note(); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    // Title + a discreet word/char count on the right (moved off the
                                    // formatting toolbar, which overflows at narrow editor widths).
                                    HorizontalLayout {
                                        spacing: 10px;
                                        LineEdit {
                                            placeholder-text: "Note title…";
                                            text <=> root.current-title;
                                            font-size: (17px * Z.f);
                                            horizontal-stretch: 1;
                                            edited(t) => { root.note-title-edited(t); }
                                        }
                                        Text {
                                            text: root.current-word-count + " words · " + root.current-char-count + " chars";
                                            font-size: (11px * Z.f); color: Theme.text3; vertical-alignment: center;
                                        }
                                    }
                                    // Labels / people / tags in this note — highlighted + clickable, kept
                                    // live as you type. (The raw editor can't colour tokens inline — Slint
                                    // TextEdit is single-style — so this strip surfaces them instead.)
                                    if (root.current-projects.length + root.current-people.length + root.current-tags.length > 0): Rectangle {
                                        height: ent.preferred-height + 8px;
                                        background: Theme.surface2;
                                        border-radius: 6px;
                                        ent := HorizontalLayout {
                                            padding: 4px; spacing: 6px; alignment: start;
                                            Text { text: "In this note:"; font-size: (10px * Z.f); color: Theme.text3; vertical-alignment: center; }
                                            for p in root.current-projects: LinkChip { text: "▸ " + p; tint: #e7f7ec; ink: #1f7a44; clicked => { root.toggle-project(p); } }
                                            for pe in root.current-people: LinkChip { text: "@ " + pe; tint: #fdeede; ink: #9a5b1b; clicked => { root.toggle-person(pe); } }
                                            for tg in root.current-tags: LinkChip { text: "# " + tg; tint: #f3ecfb; ink: #5b1b9a; clicked => { root.toggle-tag(tg); } }
                                        }
                                    }
                                    // backlinks — other notes that reference this one
                                    if (root.current-backlinks.length > 0): HorizontalLayout {
                                        spacing: 5px;
                                        alignment: start;
                                        Text { text: "↩ referenced by:"; font-size: (11px * Z.f); color: Theme.text3; vertical-alignment: center; }
                                        for r in root.current-backlinks: LinkChip { text: r.title; tint: #eef2f7; ink: #4a5560; clicked => { root.select-note(r.id); } }
                                    }
                                    // related prior meetings (shared workstream/people/tags) — click to
                                    // insert a [[link]] into this note; → opens it instead.
                                    if (root.current-related.length > 0 && !root.source-mode): HorizontalLayout {
                                        spacing: 5px;
                                        alignment: start;
                                        Image { source: Icons.external; colorize: Theme.text3; width: 13px * Z.f; height: 13px * Z.f; vertical-alignment: center; }
                                        Text { text: "link a related meeting:"; font-size: (11px * Z.f); color: Theme.text3; vertical-alignment: center; }
                                        for r in root.current-related: LinkChip {
                                            text: r.via == "" ? r.title : r.title + "  · via " + r.via;
                                            tint: Theme.sel; ink: Theme.accent;
                                            clicked => { root.link-related(r.title); }
                                        }
                                    }
                                    // Find / replace bar (Ctrl/⌘+F) — operates on the sred editor.
                                    if (root.find-open && !root.source-mode): Rectangle {
                                        height: fbar.preferred-height + 10px;
                                        background: Theme.surface2;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        fbar := HorizontalLayout {
                                            padding: 5px; spacing: 6px;
                                            findinput := LineEdit {
                                                placeholder-text: "Find…";
                                                text <=> root.find-query;
                                                horizontal-stretch: 1;
                                                edited(t) => { root.find-search(t); }
                                                accepted => { root.find-step(true); }
                                            }
                                            Text { text: root.find-count > 0 ? (root.find-current + "/" + root.find-count) : "0/0"; font-size: (11px * Z.f); color: Theme.text3; vertical-alignment: center; }
                                            Button { text: "↑"; clicked => { root.find-step(false); } }
                                            Button { text: "↓"; clicked => { root.find-step(true); } }
                                            LineEdit {
                                                placeholder-text: "Replace…";
                                                text <=> root.find-replace;
                                                horizontal-stretch: 1;
                                            }
                                            Button { text: "Replace all"; clicked => { root.find-replace-all(); } }
                                            CloseX { closed => { root.find-close(); } }
                                        }
                                    }
                                    // WYSIWYG sred surface (default) — markers hidden off-caret,
                                    // headings/bullets/code rendered in place, colored entity chips.
                                    if (!root.source-mode): rich := RichTextEditor {
                                        vertical-stretch: 1;
                                        horizontal-stretch: 1;
                                        bg: Theme.surface;
                                        border-col: Theme.border;
                                        focus-col: Theme.accent;
                                        caret-col: Theme.text;
                                        frame: root.rich-frame;
                                        doc-height: root.rich-doc-height;
                                        caret-x: root.rich-caret-x;
                                        caret-y: root.rich-caret-y;
                                        caret-h: root.rich-caret-h;
                                        scroll-y <=> root.rich-scroll-y;
                                        a11y-value: root.rich-a11y;
                                        ac-items: root.rich-ac-items;
                                        ac-index: root.rich-ac-index;
                                        ac-open: root.rich-ac-open;
                                        ac-bg: Theme.surface;
                                        ac-border: Theme.border;
                                        ac-text: Theme.text;
                                        ac-sel: Theme.sel;
                                        insert-text(s) => { root.rich-insert-text(s); }
                                        chord(k) => { return root.rich-chord(k); }
                                        special(n) => { root.rich-special(n); }
                                        ac-key(k) => { root.rich-ac-key(k); }
                                        ac-pick(i) => { root.rich-ac-pick(i); }
                                        pointer-down(px, py) => { root.rich-pointer-down(px, py); }
                                        pointer-drag(px, py) => { root.rich-pointer-drag(px, py); }
                                        pointer-double(px, py) => { root.rich-pointer-double(px, py); }
                                        resized(w, h) => { root.rich-resized(w, h); }
                                        scrolled(y) => { root.rich-scrolled(y); }
                                    }
                                    // Plaintext / source mode — raw markdown in a TextEdit.
                                    if (root.source-mode): TextEdit {
                                        vertical-stretch: 1;
                                        horizontal-stretch: 1;
                                        text <=> root.current-body;
                                        wrap: word-wrap;
                                        font-family: "IBM Plex Mono";
                                        placeholder-text: "Raw markdown / Typst source…";
                                        edited => { root.note-edited(); }
                                    }
                                    // quick-add a (possibly new) workstream or label to this note
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit { placeholder-text: "add to a workstream…"; text <=> root.topic-input; horizontal-stretch: 1; accepted => { root.add-link(root.topic-input); } }
                                        ActionButton { icon: Icons.branch; label: "Add"; clicked => { root.add-link(root.topic-input); } }
                                        LineEdit { placeholder-text: "new #label…"; text <=> root.tag-input; horizontal-stretch: 1; accepted => { root.add-tag(root.tag-input); } }
                                        ActionButton { icon: Icons.labels; label: "Label"; clicked => { root.add-tag(root.tag-input); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton { icon: Icons.edit; label: root.source-mode ? "Rich text" : "Source"; clicked => { root.source-mode = !root.source-mode; } }
                                        ActionButton { icon: Icons.check; label: "Add todo"; clicked => { root.open-add-todo(); } }
                                        ActionButton { icon: Icons.branch; label: "Related note"; clicked => { root.new-related-note(); } }
                                        ActionButton { icon: Icons.notes; label: root.current-kind; clicked => { root.toggle-kind(); } }
                                        Rectangle { horizontal-stretch: 1; }
                                        LineEdit { placeholder-text: "attach path…"; text <=> root.attach-input; horizontal-stretch: 1; accepted => { root.attach-path(root.attach-input); } }
                                        ActionButton { icon: Icons.paperclip; label: ""; a11y: "Attach path"; clicked => { root.attach-path(root.attach-input); } }
                                    }
                                }
                            }
                            // Read-only split/reference pane — a 2nd note beside the editor.
                            if (root.split-note-id != ""): Rectangle {
                                width: 7px;
                                background: (dh.has-hover || dh.pressed) ? Theme.accent : Theme.border;
                                dh := TouchArea {
                                    mouse-cursor: ew-resize;
                                    property <length> sw;
                                    property <length> sx;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) { self.sw = root.split-width; self.sx = self.absolute-position.x + self.mouse-x; }
                                        if (e.kind == PointerEventKind.up) { root.split-resized(); }
                                    }
                                    moved => { root.split-width = clamp(self.sw - (self.absolute-position.x + self.mouse-x - self.sx), 280px, 760px); }
                                }
                            }
                            if (root.split-note-id != ""): Rectangle {
                                width: root.split-width;
                                background: Theme.surface;
                                border-radius: 8px;
                                clip: true;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: "📄 " + root.split-title; font-size: (13px * Z.f); font-weight: 700; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                        Button { text: "✎ Edit"; clicked => { root.edit-split(); } }
                                        CloseX { closed => { root.close-split(); } }
                                    }
                                    ScrollView {
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            Image { source: root.split-image; width: 100%; height: root.split-doc-height; image-fit: ImageFit.fill; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- BOARD (Kanban) view -----
                if (root.view == "board"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Board"; font-size: (22px * Z.f); font-weight: 800; color: Theme.text; }
                                Text { text: "Move active work through a flow, grouped by the way you are planning right now."; font-size: (12px * Z.f); color: Theme.text3; }
                            }
                            Rectangle {
                                width: 190px; height: 30px;
                                ComboBox {
                                    width: 100%; height: 100%;
                                    model: ["status", "kind", "workstream", "person"];
                                    current-value <=> root.group-by;
                                    selected(v) => { root.set-group-by(v); }
                                }
                            }
                            ActionButton { icon: Icons.check; label: "Add todo"; primary: true; clicked => { root.open-add-todo(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            MetricTile { value: "" + root.tasks.length; label: "visible commitments"; accent: Theme.accent; horizontal-stretch: 1; }
                            MetricTile { value: "" + root.board-columns.length; label: "groups"; accent: #1f7a44; horizontal-stretch: 1; }
                            MetricTile { value: root.active-summary == "" ? "All" : root.active-summary; label: "current filter"; accent: #9a5b1b; horizontal-stretch: 2; }
                        }
                        Flickable {
                            viewport-width: max(self.width, root.board-columns.length * 286px);
                            HorizontalLayout {
                                padding: 2px;
                                spacing: 10px;
                                for col in root.board-columns: Rectangle {
                                    width: 276px;
                                    background: Theme.surface;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            Rectangle { width: 3px; height: 18px; border-radius: 2px; background: Theme.accent; }
                                            Text { text: col.title; font-size: (13px * Z.f); font-weight: 800; color: Theme.text; horizontal-stretch: 1; overflow: elide; }
                                            Chip { text: col.count; tint: #cfd6df; ink: #4a5560; }
                                        }
                                        DropArea {
                                            vertical-stretch: 1;
                                            can-drop(e) => { return true; }
                                            dropped(e) => { root.drop-card(e.data, col.key); }
                                            ListView {
                                                for c in col.cards: Rectangle {
                                                    height: 118px;
                                                    background: cardta.has-hover ? Theme.surface2 : Theme.surface3;
                                                    border-radius: 7px;
                                                    border-width: 1px;
                                                    border-color: cardta.has-hover ? Theme.accent : transparent;
                                                    animate background { duration: 120ms; }
                                                    cardta := TouchArea {
                                                    // Double-click the card → open its note at the todo's line.
                                                    double-clicked => { root.open-note(c.id); }
                                                    VerticalLayout {
                                                        padding: 9px;
                                                        spacing: 7px;
                                                        DragArea {
                                                            mime-type: "text/plain";
                                                            data: c.id;
                                                            VerticalLayout {
                                                                spacing: 7px;
                                                                HorizontalLayout {
                                                                    spacing: 6px;
                                                                    KindDot { kind: c.kind; }
                                                                    Text { text: c.text; font-size: (12px * Z.f); font-weight: 650; color: c.done ? Theme.text3 : Theme.text; overflow: elide; horizontal-stretch: 1; }
                                                                }
                                                                HorizontalLayout {
                                                                    spacing: 4px;
                                                                    Chip { text: c.status; tint: #eef2f7; ink: #67727d; }
                                                                    Chip { text: c.project; tint: #e7f7ec; ink: #1f7a44; }
                                                                    Chip { text: c.person; tint: #fdeede; ink: #9a5b1b; }
                                                                    Chip { text: c.due; tint: #fde7ea; ink: #9a1b33; }
                                                                    ExtChip { text: c.external; clicked => { root.open-external(c.external); } }
                                                                }
                                                            }
                                                        }
                                                        HorizontalLayout {
                                                            spacing: 4px;
                                                            opacity: cardta.has-hover ? 1.0 : 0.0;
                                                            animate opacity { duration: 120ms; }
                                                            MiniBtn { label: "◀"; clicked => { root.board-move(c.id, -1); } }
                                                            MiniBtn { label: "▶"; clicked => { root.board-move(c.id, 1); } }
                                                            MiniBtn { label: "✎"; clicked => { root.edit-todo(c.id); } }
                                                            Rectangle { horizontal-stretch: 1; }
                                                            MiniBtn { label: "↗"; clicked => { root.open-note(c.id); } }
                                                        }
                                                    }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- CALENDAR view -----
                if (root.view == "calendar"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 10px; spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "◀"; clicked => { root.cal-prev(); } }
                            Text { text: root.cal-label; font-size: 16px * Z.f; font-weight: 800; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; horizontal-stretch: 1; }
                            Button { text: "Today"; clicked => { root.cal-today(); } }
                            Button { text: "▶"; clicked => { root.cal-next(); } }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            for wd in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: Text { text: wd; font-size: 10px * Z.f; letter-spacing: 0.5px; color: Theme.text3; horizontal-stretch: 1; horizontal-alignment: center; }
                        }
                        for r in [0, 1, 2, 3, 4, 5]: HorizontalLayout {
                            spacing: 4px;
                            for c in [0, 1, 2, 3, 4, 5, 6]: Rectangle {
                                property <CalCell> cell: root.cal-cells[r * 7 + c];
                                horizontal-stretch: 1;
                                clip: true;
                                background: cell.day == 0 ? transparent : (cell.today ? Theme.sel : white);
                                border-radius: 5px;
                                border-width: cell.today ? 1.5px : 0px;
                                border-color: Theme.accent;
                                VerticalLayout {
                                    padding: 3px;
                                    spacing: 1px;
                                    Text { text: cell.day == 0 ? "" : cell.day; font-size: 11px * Z.f; font-weight: cell.today ? 800 : 500; color: cell.today ? Theme.accent : Theme.text2; }
                                    for it in cell.items: Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: cit.has-hover ? #e7f7ec : Theme.surface3;
                                        HorizontalLayout {
                                            padding-left: 3px; padding-right: 2px; spacing: 2px;
                                            KindDot { kind: it.kind; }
                                            Text { text: it.text; font-size: 9px * Z.f; color: it.done ? Theme.text3 : Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                        }
                                        cit := TouchArea { mouse-cursor: pointer; clicked => { root.open-note(it.id); } }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- TODAY dashboard -----
                if (root.view == "today"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 12px; spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Today"; font-size: (22px * Z.f); font-weight: 800; color: Theme.text; }
                                Text { text: "Triage what needs attention, then move into notes or agenda."; font-size: (12px * Z.f); color: Theme.text3; }
                            }
                            ActionButton { icon: Icons.plus; label: "Capture"; clicked => { root.quick-capture-open = true; } }
                            ActionButton { icon: Icons.refresh; label: "Refresh"; clicked => { root.reindex(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            MetricTile { value: "" + root.agenda-overdue.length; label: "overdue"; accent: #c82333; horizontal-stretch: 1; }
                            MetricTile { value: "" + root.agenda-today.length; label: "due today"; accent: #1f7a44; horizontal-stretch: 1; }
                            MetricTile { value: "" + root.today-stale.length; label: "stale follow-ups"; accent: #d98324; horizontal-stretch: 1; }
                            MetricTile { value: "" + root.inbox-notes.length; label: "unfiled inbox"; accent: #5b1b9a; horizontal-stretch: 1; }
                        }
                        tdsv := ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                width: tdsv.visible-width;
                                spacing: 10px;
                                Rectangle {
                                    background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                                    VerticalLayout {
                                        padding: 10px; spacing: 3px;
                                        SectionTitle { title: "OVERDUE"; detail: root.agenda-overdue.length + " needs recovery"; accent: #c82333; }
                                        for t in root.agenda-overdue: AgendaRow { t: t; cycle(id) => { root.cycle-todo(id); } edit(id) => { root.edit-todo(id); } open(id) => { root.open-note(id); } }
                                        if (root.agenda-overdue.length == 0): Text { text: "Nothing overdue."; color: Theme.text3; font-size: (12px * Z.f); font-italic: true; }
                                    }
                                }
                                Rectangle {
                                    background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                                    VerticalLayout {
                                        padding: 10px; spacing: 3px;
                                        SectionTitle { title: "DUE TODAY"; detail: root.agenda-today.length + " scheduled commitments"; accent: #1f7a44; }
                                        for t in root.agenda-today: AgendaRow { t: t; cycle(id) => { root.cycle-todo(id); } edit(id) => { root.edit-todo(id); } open(id) => { root.open-note(id); } }
                                        if (root.agenda-today.length == 0): Text { text: "No due-date pressure today."; color: Theme.text3; font-size: (12px * Z.f); font-italic: true; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                                        VerticalLayout {
                                            padding: 10px; spacing: 3px;
                                            SectionTitle { title: "FOLLOW-UP"; detail: root.today-stale.length + " aging loops"; accent: #d98324; }
                                            for t in root.today-stale: AgendaRow { t: t; cycle(id) => { root.cycle-todo(id); } edit(id) => { root.edit-todo(id); } open(id) => { root.open-note(id); } }
                                            if (root.today-stale.length == 0): Text { text: "No stale follow-ups."; color: Theme.text3; font-size: (12px * Z.f); font-italic: true; }
                                        }
                                    }
                                    Rectangle {
                                        width: 300px;
                                        background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                                        VerticalLayout {
                                            padding: 10px; spacing: 6px;
                                            HorizontalLayout {
                                                SectionTitle { title: "INBOX"; detail: root.inbox-notes.length + " unfiled"; accent: #5b1b9a; horizontal-stretch: 1; }
                                                Button { text: "Open"; clicked => { root.set-view("inbox"); } }
                                            }
                                            SectionTitle { title: "RECENT"; detail: "edited notes"; accent: Theme.text3; }
                                            for n in root.today-recent: NoteRow { note: n; open(id) => { root.select-note(id); root.set-view("notes"); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- TRASH view -----
                if (root.view == "trash"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 10px; spacing: 8px;
                        HorizontalLayout {
                            Text { text: "TRASH — deleted notes (restore to bring them back)"; font-size: (11px * Z.f); letter-spacing: 0.5px; color: Theme.text3; vertical-alignment: center; horizontal-stretch: 1; }
                            CloseX { closed => { root.set-view(root.prev-view); } }
                        }
                        Rectangle {
                            vertical-stretch: 1; background: Theme.surface; border-radius: 8px;
                            ListView {
                                for r in root.trash-notes: Rectangle {
                                    height: 40px;
                                    HorizontalLayout {
                                        padding: 6px; spacing: 8px;
                                        Text { text: r.title; font-size: (13px * Z.f); color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                        Button { text: "Restore"; clicked => { root.restore-note(r.id); } }
                                    }
                                }
                            }
                            if (root.trash-notes.length == 0): Text { x: 12px; y: 12px; text: "Trash is empty."; color: Theme.text3; font-size: (13px * Z.f); font-italic: true; }
                        }
                    }
                }

                // ----- SETTINGS view -----
                if (root.view == "settings"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    setsv := ScrollView {
                    VerticalLayout {
                        width: setsv.visible-width;
                        padding: 16px; spacing: 14px; alignment: start;

                        HorizontalLayout {
                            Text { text: "Settings"; font-size: (20px * Z.f); font-weight: 700; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
                            CloseX { closed => { root.set-view(root.prev-view); } }
                        }

                        // --- Vault location (editable) ---
                        Rectangle {
                            background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                            VerticalLayout {
                                padding: 14px; spacing: 8px;
                                Text { text: "Vault folder"; font-size: (13px * Z.f); font-weight: 700; color: Theme.text; }
                                Text {
                                    text: "Where your plain-markdown notes live. The index is kept elsewhere (below) so it never syncs.";
                                    font-size: (11px * Z.f); color: Theme.text3; wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    vault-field := LineEdit {
                                        text <=> root.vault-input;
                                        placeholder-text: "/path/to/your/vault";
                                        horizontal-stretch: 1;
                                    }
                                    Button {
                                        text: "Save";
                                        primary: true;
                                        clicked => { root.save-settings(vault-field.text); }
                                    }
                                }
                                Text {
                                    text: "Switching vaults takes effect after you restart Noet. The $NOET_VAULT environment variable, if set, overrides this.";
                                    font-size: (10px * Z.f); font-italic: true; color: Theme.text3; wrap: word-wrap;
                                }
                            }
                        }

                        // --- Storage locations (read-only) ---
                        Rectangle {
                            background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                            VerticalLayout {
                                padding: 14px; spacing: 10px;
                                Text { text: "Storage"; font-size: (13px * Z.f); font-weight: 700; color: Theme.text; }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "Index cache (rebuildable; safe to delete)"; font-size: (11px * Z.f); color: Theme.text3; }
                                    Text { text: root.index-path; font-size: (12px * Z.f); color: Theme.text; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "Settings file"; font-size: (11px * Z.f); color: Theme.text3; }
                                    Text { text: root.settings-path; font-size: (12px * Z.f); color: Theme.text; wrap: word-wrap; }
                                }
                            }
                        }

                        // --- Startup (Windows) ---
                        if (root.launch-on-startup-supported): Rectangle {
                            background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                            VerticalLayout {
                                padding: 14px; spacing: 8px;
                                Text { text: "Startup"; font-size: (13px * Z.f); font-weight: 700; color: Theme.text; }
                                CheckBox {
                                    text: "Launch Noet when I sign in";
                                    checked <=> root.launch-on-startup;
                                    toggled => { root.set-launch-on-startup(self.checked); }
                                }
                                Text {
                                    text: "Per-user, no admin needed. Noet stays out of your way and is one click (or hotkey) away when a meeting starts.";
                                    font-size: (10px * Z.f); color: Theme.text3; wrap: word-wrap;
                                }
                            }
                        }

                        // --- About / licenses ---
                        Rectangle {
                            background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                            VerticalLayout {
                                padding: 14px; spacing: 8px;
                                Text { text: "About"; font-size: (13px * Z.f); font-weight: 700; color: Theme.text; }
                                Text { text: "Noet — native (Rust + Slint) notes, todos & projects over plain markdown."; font-size: (11px * Z.f); color: Theme.text3; wrap: word-wrap; }
                                HorizontalLayout {
                                    Rectangle { horizontal-stretch: 1; }
                                    Button { text: "Open-source licenses →"; clicked => { root.set-view("about"); } }
                                }
                            }
                        }
                    }
                    }
                }

                // ----- ABOUT / OPEN-SOURCE LICENSES view -----
                if (root.view == "about"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Open-source licenses"; font-size: (20px * Z.f); font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: "Open full notices"; primary: true; clicked => { root.open-licenses(); } }
                            CloseX { closed => { root.set-view(root.prev-view); } }
                        }
                        Text {
                            text: "Noet's UI is built with Slint (tri-licensed: GPL-3.0, commercial, or Slint Royalty-free/Software). " + root.license-summary;
                            font-size: (11px * Z.f); color: Theme.text3; wrap: word-wrap;
                        }
                        // Per-component list (virtualized). "Open full notices" shows the
                        // complete license texts for every component.
                        Rectangle {
                            vertical-stretch: 1; background: Theme.surface; border-radius: 8px;
                            border-width: 1px; border-color: Theme.border;
                            ListView {
                                for r[i] in root.license-rows: Rectangle {
                                    height: 30px;
                                    background: Math.mod(i, 2) == 0 ? transparent : Theme.surface2;
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 10px; spacing: 8px;
                                        Text { text: r.crate-name; font-size: (12px * Z.f); color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                        Text { text: r.version; font-size: (11px * Z.f); color: Theme.text3; vertical-alignment: center; width: 80px; }
                                        Text { text: r.license; font-size: (11px * Z.f); color: Theme.text2; vertical-alignment: center; width: 280px; overflow: elide; }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- PEOPLE view (1:1 prep) -----
                if (root.view == "people"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    HorizontalLayout {
                        padding: 12px; spacing: 12px;
                        Rectangle {
                            width: 250px; background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                            VerticalLayout {
                                padding: 10px; spacing: 6px;
                                Text { text: "People"; font-size: (20px * Z.f); font-weight: 800; color: Theme.text; }
                                Text { text: "Pick a person to prep discussion, delegation, and recent context."; font-size: (11px * Z.f); color: Theme.text3; wrap: word-wrap; }
                                Rectangle { height: 1px; background: Theme.border; }
                                ListView {
                                    vertical-stretch: 1;
                                    for p in root.people: FacetRow {
                                        name: "@ " + p.name;
                                        count: p.count;
                                        active: p.name == root.selected-person;
                                        ink: #9a5b1b; hover-bg: #fdf2e6;
                                        clicked => { root.pick-person(p.name); }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1; background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        Text {
                                            text: root.selected-person == "" ? "1:1 cockpit" : root.selected-person;
                                            font-size: (22px * Z.f); font-weight: 800; color: Theme.text;
                                        }
                                        Text {
                                            text: root.selected-person == "" ? "Select someone from the left to build a prep brief." : "Write the current 1:1 while reviewing prior notes and delegated follow-ups.";
                                            font-size: (12px * Z.f); color: Theme.text3;
                                        }
                                    }
                                    if root.selected-person != "": ActionButton { icon: Icons.meeting; label: "New 1:1 note"; clicked => { root.new-from-template("oneonone"); } }
                                }
                                if root.selected-person == "": EmptyState {
                                    glyph: "@";
                                    title: "Pick a person";
                                    hint: "Noet will collect discussion points, delegated work, and recent notes here.";
                                }
                                if root.selected-person != "": HorizontalLayout {
                                    spacing: 8px;
                                    MetricTile { value: "" + root.person-discuss.length; label: "to discuss"; accent: #9a5b1b; horizontal-stretch: 1; }
                                    MetricTile { value: "" + root.person-delegated.length; label: "delegated"; accent: #1f7a44; horizontal-stretch: 1; }
                                    MetricTile { value: "" + root.person-other.length; label: "other todos"; accent: Theme.accent; horizontal-stretch: 1; }
                                    MetricTile { value: "" + root.person-oneonone-notes.length; label: "1:1 notes"; accent: Theme.text2; horizontal-stretch: 1; }
                                }
                                if root.selected-person != "": HorizontalLayout {
                                    spacing: 12px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 280px;
                                        background: Theme.surface2;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        VerticalLayout {
                                            padding: 10px; spacing: 8px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                SectionTitle {
                                                    title: "CURRENT 1:1";
                                                    detail: root.person-current-oneonone-title == "" ? "create one to start writing" : root.person-current-oneonone-title;
                                                    accent: #9a5b1b;
                                                    horizontal-stretch: 1;
                                                }
                                                if root.person-current-oneonone-id != "": Button { text: "Open full editor"; clicked => { root.select-note(root.person-current-oneonone-id); root.set-view("notes"); } }
                                            }
                                            if root.person-current-oneonone-id == "": EmptyState {
                                                glyph: "1:1";
                                                title: "No current 1:1 note";
                                                hint: "Create a 1:1 note to write live notes here.";
                                            }
                                            if root.person-current-oneonone-id != "": LineEdit {
                                                text <=> root.current-title;
                                                edited(t) => { root.note-title-edited(t); }
                                            }
                                            if root.person-current-oneonone-id != "": TextEdit {
                                                vertical-stretch: 1;
                                                text <=> root.current-body;
                                                wrap: word-wrap;
                                                placeholder-text: "Type live 1:1 notes, decisions, and follow-up todos here...";
                                                edited => { root.note-edited(); }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 310px;
                                        height: 280px;
                                        background: Theme.surface2;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        VerticalLayout {
                                            padding: 10px; spacing: 6px;
                                            SectionTitle { title: "1:1 NOTES"; detail: root.person-oneonone-notes.length + " notes"; accent: Theme.text2; }
                                            if root.person-oneonone-notes.length == 0 : Text { text: "No 1:1 notes for this person yet."; color: Theme.text3; font-size: (12px * Z.f); font-italic: true; }
                                            ListView {
                                                vertical-stretch: 1;
                                                for n in root.person-oneonone-notes: NoteRow { note: n; open(id) => { root.select-note(id); root.set-view("notes"); } }
                                            }
                                        }
                                    }
                                }
                                if root.selected-person != "": ppsv := ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        width: ppsv.visible-width;
                                        spacing: 10px;
                                        Rectangle {
                                            background: Theme.surface2; border-radius: 7px;
                                            VerticalLayout {
                                                padding: 10px; spacing: 3px;
                                                SectionTitle { title: "DISCUSS"; detail: root.person-discuss.length + " prompts for the next 1:1"; accent: #9a5b1b; }
                                                for t in root.person-discuss: AgendaRow { t: t; cycle(id) => { root.cycle-todo(id); } edit(id) => { root.edit-todo(id); } open(id) => { root.open-note(id); } }
                                                if (root.person-discuss.length == 0): Text { text: "Nothing queued to discuss."; color: Theme.text3; font-size: (12px * Z.f); font-italic: true; }
                                            }
                                        }
                                        Rectangle {
                                            background: Theme.surface2; border-radius: 7px;
                                            VerticalLayout {
                                                padding: 10px; spacing: 3px;
                                                SectionTitle { title: "DELEGATED"; detail: root.person-delegated.length + " items you are waiting on"; accent: #1f7a44; }
                                                for t in root.person-delegated: AgendaRow { t: t; cycle(id) => { root.cycle-todo(id); } edit(id) => { root.edit-todo(id); } open(id) => { root.open-note(id); } }
                                                if (root.person-delegated.length == 0): Text { text: "No delegated items waiting."; color: Theme.text3; font-size: (12px * Z.f); font-italic: true; }
                                            }
                                        }
                                        Rectangle {
                                            background: Theme.surface2; border-radius: 7px;
                                            VerticalLayout {
                                                padding: 10px; spacing: 3px;
                                                SectionTitle { title: "DELEGATED HISTORY"; detail: root.person-delegated-history.length + " past and current items"; accent: #1f7a44; }
                                                for t in root.person-delegated-history: AgendaRow { t: t; cycle(id) => { root.cycle-todo(id); } edit(id) => { root.edit-todo(id); } open(id) => { root.open-note(id); } }
                                                if (root.person-delegated-history.length == 0): Text { text: "No delegated history yet."; color: Theme.text3; font-size: (12px * Z.f); font-italic: true; }
                                            }
                                        }
                                        Rectangle {
                                            background: Theme.surface2; border-radius: 7px;
                                            VerticalLayout {
                                                padding: 10px; spacing: 3px;
                                                SectionTitle { title: "OTHER TODOS"; detail: root.person-other.length + " related tasks"; accent: Theme.accent; }
                                                for t in root.person-other: AgendaRow { t: t; cycle(id) => { root.cycle-todo(id); } edit(id) => { root.edit-todo(id); } open(id) => { root.open-note(id); } }
                                            }
                                        }
                                        Rectangle {
                                            background: Theme.surface2; border-radius: 7px;
                                            VerticalLayout {
                                                padding: 10px; spacing: 3px;
                                                SectionTitle { title: "RECENT CONTEXT"; detail: root.person-notes.length + " notes mention them"; accent: Theme.text2; }
                                                for n in root.person-notes: NoteRow { note: n; open(id) => { root.select-note(id); root.set-view("notes"); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- AGENDA view -----
                if (root.view == "agenda"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 10px; spacing: 8px;
                        Text { text: "AGENDA — what's due, by date"; font-size: (11px * Z.f); letter-spacing: 0.5px; color: Theme.text3; }
                        Rectangle {
                            vertical-stretch: 1; background: Theme.surface; border-radius: 8px;
                            agsv := ScrollView {
                                VerticalLayout {
                                    width: agsv.visible-width;
                                    padding: 8px;
                                    spacing: 12px;
                                    if (root.agenda-overdue.length > 0): VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "⚠ OVERDUE (" + root.agenda-overdue.length + ")"; font-size: (11px * Z.f); font-weight: 700; color: #c82333; }
                                        for t in root.agenda-overdue: AgendaRow { t: t; cycle(id) => { root.cycle-todo(id); } edit(id) => { root.edit-todo(id); } open(id) => { root.open-note(id); } }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "TODAY (" + root.agenda-today.length + ")"; font-size: (11px * Z.f); font-weight: 700; color: #1f7a44; }
                                        for t in root.agenda-today: AgendaRow { t: t; cycle(id) => { root.cycle-todo(id); } edit(id) => { root.edit-todo(id); } open(id) => { root.open-note(id); } }
                                        if (root.agenda-today.length == 0): Text { text: "Nothing due today."; color: Theme.text3; font-size: (12px * Z.f); font-italic: true; }
                                    }
                                    if (root.agenda-week.length > 0): VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "NEXT 7 DAYS (" + root.agenda-week.length + ")"; font-size: (11px * Z.f); font-weight: 700; color: Theme.accent; }
                                        for t in root.agenda-week: AgendaRow { t: t; cycle(id) => { root.cycle-todo(id); } edit(id) => { root.edit-todo(id); } open(id) => { root.open-note(id); } }
                                    }
                                    if (root.agenda-later.length > 0): VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "LATER (" + root.agenda-later.length + ")"; font-size: (11px * Z.f); font-weight: 700; color: Theme.text2; }
                                        for t in root.agenda-later: AgendaRow { t: t; cycle(id) => { root.cycle-todo(id); } edit(id) => { root.edit-todo(id); } open(id) => { root.open-note(id); } }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- INBOX view (quick capture + unfiled notes) -----
                if (root.view == "inbox"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    HorizontalLayout {
                        padding: 12px; spacing: 12px;
                        Rectangle {
                            width: 340px;
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 14px; spacing: 10px;
                                Text { text: "Inbox"; font-size: (22px * Z.f); font-weight: 800; color: Theme.text; }
                                Text { text: "Capture loosely. Triage later into notes, workstreams, people, and todos."; font-size: (12px * Z.f); color: Theme.text3; wrap: word-wrap; }
                                LineEdit {
                                    placeholder-text: "Capture a thought, promise, or loose note";
                                    text <=> root.capture-input;
                                    accepted => { root.quick-capture(root.capture-input); }
                                }
                                ActionButton { icon: Icons.plus; label: "Capture to inbox"; primary: true; clicked => { root.quick-capture(root.capture-input); } }
                                Rectangle { height: 1px; background: Theme.border; }
                                SectionTitle { title: "TRIAGE FLOW"; detail: "open an item, then file it"; accent: #5b1b9a; }
                                Text { text: "1. Open the oldest loose note\n2. Add a workstream or person\n3. Convert next actions into todos\n4. Archive or keep as reference"; font-size: (12px * Z.f); color: Theme.text2; wrap: word-wrap; }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 10px; spacing: 6px;
                                HorizontalLayout {
                                    SectionTitle { title: "UNFILED"; detail: root.inbox-notes.length + " notes need a home"; accent: #5b1b9a; horizontal-stretch: 1; }
                                    ActionButton { icon: Icons.plus; label: "New note"; clicked => { root.new-note(); } }
                                }
                                if root.inbox-notes.length == 0 : EmptyState {
                                    glyph: "Inbox";
                                    title: "Inbox zero";
                                    hint: "Nothing unfiled. Capture on the left, or add [[workstreams]] to existing notes.";
                                }
                                ListView {
                                    vertical-stretch: 1;
                                    for n in root.inbox-notes: Rectangle {
                                        height: 58px;
                                        border-radius: 7px;
                                        background: ibt.has-hover ? Theme.surface3 : transparent;
                                        animate background { duration: 100ms; }
                                        HorizontalLayout {
                                            padding: 8px; spacing: 8px;
                                            Rectangle { width: 3px; height: 100%; border-radius: 2px; background: #5b1b9a; }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                Text { text: n.title; font-size: (13px * Z.f); font-weight: 700; color: Theme.text; overflow: elide; }
                                                Text { text: n.subtitle; font-size: (10px * Z.f); color: Theme.text3; overflow: elide; }
                                            }
                                            Button { text: "Triage"; clicked => { root.select-note(n.id); root.set-view("notes"); } }
                                        }
                                        ibt := TouchArea { mouse-cursor: pointer; double-clicked => { root.select-note(n.id); root.set-view("notes"); } }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- TASKS view (commitment command center) -----
                if (root.view == "tasks"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Tasks"; font-size: (22px * Z.f); font-weight: 800; color: Theme.text; }
                                Text { text: "Work from a clean commitment list. Complete, edit, or jump back to the source note."; font-size: (12px * Z.f); color: Theme.text3; }
                            }
                            ActionButton { icon: Icons.check; label: "Add todo"; primary: true; clicked => { root.open-add-todo(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            MetricTile { value: "" + root.tasks.length; label: "matching tasks"; accent: Theme.accent; horizontal-stretch: 1; }
                            MetricTile { value: "" + root.agenda-overdue.length; label: "overdue"; accent: #c82333; horizontal-stretch: 1; }
                            MetricTile { value: "" + root.agenda-today.length; label: "due today"; accent: #1f7a44; horizontal-stretch: 1; }
                            MetricTile { value: root.active-summary == "" ? "All" : root.active-summary; label: "active filter"; accent: #9a5b1b; horizontal-stretch: 2; }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                SectionTitle { title: "COMMITMENTS"; detail: root.tasks.length + " visible items"; accent: Theme.accent; }
                            if root.tasks.length == 0 : EmptyState {
                                glyph: "Tasks";
                                title: "No tasks match";
                                hint: "Add a todo, or loosen the filters in the rail.";
                            }
                            ListView {
                                vertical-stretch: 1;
                                for t in root.tasks: CommitmentRow {
                                    t: t;
                                    accent: Theme.accent;
                                    action-label: "Open note";
                                    cycle(id) => { root.cycle-todo(id); }
                                    edit(id) => { root.edit-todo(id); }
                                    external(id) => { root.open-external(id); }
                                    open(id) => { root.open-note(id); }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- WAITING view (follow-up queue) -----
                if (root.view == "waiting"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Waiting"; font-size: (22px * Z.f); font-weight: 800; color: Theme.text; }
                                Text { text: "Track delegated work and decide who needs a nudge before it goes stale."; font-size: (12px * Z.f); color: Theme.text3; }
                            }
                            ActionButton { icon: Icons.meeting; label: "People"; clicked => { root.set-view("people"); } }
                            ActionButton { icon: Icons.check; label: "Add follow-up"; primary: true; clicked => { root.open-add-todo(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            MetricTile { value: "" + root.waiting-todos.length; label: "delegated items"; accent: #1f7a44; horizontal-stretch: 1; }
                            MetricTile { value: "" + root.person-delegated.length; label: "selected person"; accent: #9a5b1b; horizontal-stretch: 1; }
                            MetricTile { value: root.selected-person == "" ? "All people" : root.selected-person; label: "people filter"; accent: Theme.accent; horizontal-stretch: 2; }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                SectionTitle { title: "FOLLOW-UP QUEUE"; detail: "oldest delegated items first"; accent: #1f7a44; }
                            if root.waiting-todos.length == 0 : EmptyState {
                                glyph: "Waiting";
                                title: "Nothing delegated";
                                hint: "Delegated todos with a person show here. Use the person filter to prep a focused follow-up.";
                            }
                            ListView {
                                vertical-stretch: 1;
                                for t in root.waiting-todos: CommitmentRow {
                                    t: t;
                                    accent: #1f7a44;
                                    action-label: "Nudge";
                                    cycle(id) => { root.cycle-todo(id); }
                                    edit(id) => { root.edit-todo(id); }
                                    external(id) => { root.open-external(id); }
                                    open(id) => { root.open-note(id); }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- WORKSTREAM HUB (one workstream's todos + notes) -----
                if (root.view == "workstream"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: root.hub-name == "" ? "Workstream" : root.hub-name; font-size: (22px * Z.f); font-weight: 800; color: Theme.text; }
                                Text { text: "Project cockpit: open loops, related notes, and next actions in one place."; font-size: (12px * Z.f); color: Theme.text3; }
                            }
                            ActionButton { icon: Icons.filter-x; label: "Filter notes"; clicked => { root.toggle-project(root.hub-name); root.set-view("notes"); } }
                            ActionButton { icon: Icons.check; label: "Add todo"; primary: true; clicked => { root.open-add-todo(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            MetricTile { value: "" + root.hub-todos.length; label: "open todos"; accent: Theme.accent; horizontal-stretch: 1; }
                            MetricTile { value: "" + root.hub-notes.length; label: "linked notes"; accent: #1f7a44; horizontal-stretch: 1; }
                            MetricTile { value: root.selected-person == "" ? "-" : root.selected-person; label: "person filter"; accent: #9a5b1b; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            // Left: open todos in this workstream.
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.surface;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 10px; spacing: 6px;
                                    SectionTitle { title: "OPEN LOOPS"; detail: root.hub-todos.length + " active commitments"; accent: Theme.accent; }
                                    if root.hub-todos.length == 0 : Text { text: "No open todos in this workstream."; font-size: (12px * Z.f); color: Theme.text3; }
                                    ListView {
                                        vertical-stretch: 1;
                                        for t in root.hub-todos: AgendaRow {
                                            t: t;
                                            cycle(id) => { root.cycle-todo(id); }
                                            edit(id) => { root.edit-todo(id); }
                                            open(id) => { root.open-note(id); }
                                        }
                                    }
                                }
                            }
                            // Right: notes that reference this workstream.
                            Rectangle {
                                width: 340px;
                                background: Theme.surface;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 10px; spacing: 6px;
                                    SectionTitle { title: "REFERENCE"; detail: root.hub-notes.length + " linked notes"; accent: #1f7a44; }
                                    if root.hub-notes.length == 0 : Text { text: "No notes link [[" + root.hub-name + "]] yet."; font-size: (12px * Z.f); color: Theme.text3; wrap: word-wrap; }
                                    ListView {
                                        vertical-stretch: 1;
                                        for n in root.hub-notes: Rectangle {
                                            height: 42px;
                                            border-radius: 6px;
                                            background: hnt.has-hover ? Theme.hover : transparent;
                                            VerticalLayout {
                                                padding-left: 8px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px;
                                                Text { text: n.title; font-size: (13px * Z.f); font-weight: 650; color: Theme.text; overflow: elide; }
                                                Text { text: "Open note"; font-size: (10px * Z.f); color: Theme.text3; }
                                            }
                                            hnt := TouchArea { clicked => { root.select-note(n.id); root.set-view("notes"); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- LABELS view (taxonomy manager) -----
                if (root.view == "labels"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Labels"; font-size: (22px * Z.f); font-weight: 800; color: Theme.text; }
                                Text { text: "Use labels as lightweight facets for retrieval, review, and cleanup."; font-size: (12px * Z.f); color: Theme.text3; }
                            }
                            ActionButton { icon: Icons.plus; label: "New note"; clicked => { root.new-note(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            MetricTile { value: "" + root.tags.length; label: "labels"; accent: #5b1b9a; horizontal-stretch: 1; }
                            MetricTile { value: "" + root.max-tag-count; label: "top usage"; accent: #1f7a44; horizontal-stretch: 1; }
                            MetricTile { value: root.active-summary == "" ? "All notes" : root.active-summary; label: "active filter"; accent: Theme.accent; horizontal-stretch: 2; }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                width: 300px;
                                background: Theme.surface;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    SectionTitle { title: "LABEL WORKFLOW"; detail: "keep the taxonomy small"; accent: #5b1b9a; }
                                    Text { text: "Click a label to filter notes. Prefer durable categories over one-off tags, and clean up labels with very low reuse."; font-size: (12px * Z.f); color: Theme.text2; wrap: word-wrap; }
                                    Rectangle { height: 1px; background: Theme.border; }
                                    Text { text: "Good labels answer: what context should retrieve this later?"; font-size: (12px * Z.f); color: Theme.text3; wrap: word-wrap; }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.surface;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 6px;
                                    SectionTitle { title: "FACETS"; detail: root.tags.length + " labels sorted by use"; accent: #5b1b9a; }
                                    if (root.tags.length == 0): EmptyState {
                                        glyph: "Labels";
                                        title: "No labels yet";
                                        hint: "Add #labels to notes when a reusable retrieval facet appears.";
                                    }
                                    lsv := ScrollView {
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            width: lsv.visible-width;
                                            spacing: 6px;
                                            for t in root.tags: Rectangle {
                                                height: 42px;
                                                border-radius: 7px;
                                                background: lt.has-hover ? #ede3fb : Theme.surface2;
                                                animate background { duration: 110ms; easing: ease-out; }
                                                HorizontalLayout {
                                                    padding-left: 10px; padding-right: 10px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: "#" + t.name;
                                                        color: #5b1b9a;
                                                        font-weight: 700;
                                                        font-size: min(13px + t.count * 8px / max(1, root.max-tag-count), 18px) * Z.f;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    Chip { text: t.count; tint: #eef2f7; ink: #4a5560; }
                                                    Button { text: "Filter"; clicked => { root.toggle-tag(t.name); } }
                                                }
                                                lt := TouchArea { mouse-cursor: pointer; double-clicked => { root.toggle-tag(t.name); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- GANTT view -----
                if (root.view == "gantt"): Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Timeline"; font-size: (22px * Z.f); font-weight: 800; color: Theme.text; }
                                Text { text: "See scheduled commitments as a planning horizon, then open the source note for detail."; font-size: (12px * Z.f); color: Theme.text3; }
                            }
                            ActionButton { icon: Icons.check; label: "Add dated todo"; primary: true; clicked => { root.open-add-todo(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            MetricTile { value: "" + root.gantt-items.length; label: "scheduled items"; accent: Theme.accent; horizontal-stretch: 1; }
                            MetricTile { value: "" + root.agenda-week.length; label: "next 7 days"; accent: #1f7a44; horizontal-stretch: 1; }
                            MetricTile { value: "" + root.agenda-later.length; label: "later"; accent: #9a5b1b; horizontal-stretch: 1; }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                SectionTitle { title: "PLANNING HORIZON"; detail: "start to due date"; accent: Theme.accent; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Commitment"; width: 260px; font-size: (10px * Z.f); font-weight: 800; color: Theme.text3; }
                                    Text { text: "Schedule"; horizontal-stretch: 1; font-size: (10px * Z.f); font-weight: 800; color: Theme.text3; }
                                }
                                if root.gantt-items.length == 0 : EmptyState {
                                    glyph: "Timeline";
                                    title: "No dated work";
                                    hint: "Add due dates to todos to plan the horizon here.";
                                }
                                ListView {
                                    vertical-stretch: 1;
                                    for g in root.gantt-items: Rectangle {
                                        height: 46px;
                                        border-radius: 7px;
                                        background: gta.has-hover ? Theme.surface3 : transparent;
                                        animate background { duration: 100ms; }
                                        gta := TouchArea { mouse-cursor: pointer; double-clicked => { root.open-note(g.id); } }
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; spacing: 10px;
                                            HorizontalLayout {
                                                width: 260px;
                                                spacing: 7px;
                                            KindDot { kind: g.kind; }
                                                Text { text: g.text; font-size: (12px * Z.f); font-weight: 650; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                height: 24px;
                                                y: 11px;
                                                border-radius: 5px;
                                                background: Theme.hover;
                                                Rectangle {
                                                    x: parent.width * g.start-frac;
                                                    width: max(16px, parent.width * g.span-frac);
                                                    height: 18px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 5px;
                                                    background:
                                                        g.kind == "do" ? Theme.accent :
                                                        g.kind == "followup" ? #d98324 :
                                                        g.kind == "delegated" ? #1f9d57 :
                                                        g.kind == "todelegate" ? #9a5bd6 : #6b7280;
                                                    Text { text: g.date; font-size: (10px * Z.f); font-weight: 700; color: white; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                                }
                                            }
                                            Button { text: "Open"; clicked => { root.open-note(g.id); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ===== Todo editor overlay =====
        if (root.form-visible): Rectangle {
            width: 100%; height: 100%;
            background: #0b1b2c40;
            TouchArea {} // swallow clicks behind the dialog
            Rectangle {
                width: min(560px, root.width - 28px);
                height: formbox.preferred-height;
                background: Theme.surface;
                border-radius: 10px;
                drop-shadow-blur: 18px;
                drop-shadow-color: #0000002c;
                formbox := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.form-is-new ? "Add todo" : "Edit todo";
                            font-size: (17px * Z.f); font-weight: 700; color: Theme.text;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        CloseX { closed => { root.form-visible = false; } }
                    }
                    Field {
                        label: "Task";
                        LineEdit { placeholder-text: "What needs to happen?"; text <=> root.form-text; accepted => { root.save-todo(); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Field {
                            label: "Type";
                            ComboBox {
                                model: ["do", "followup", "delegated", "todelegate", "someday", "reading"];
                                current-value <=> root.form-kind;
                            }
                        }
                        Field {
                            label: "Due";
                            LineEdit { placeholder-text: "YYYY-MM-DD"; text <=> root.form-due; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Field {
                            label: "Person";
                            LineEdit { placeholder-text: "person name"; text <=> root.form-person; }
                        }
                        Field {
                            label: "Workstream";
                            LineEdit { placeholder-text: "workstream name"; text <=> root.form-project; }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Details";
                            font-size: (12px * Z.f);
                            font-weight: 700;
                            color: Theme.text2;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button { text: root.form-show-details ? "Hide" : "Show"; clicked => { root.form-show-details = !root.form-show-details; } }
                    }
                    if (root.form-show-details): VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            Field {
                                label: "Status";
                                ComboBox {
                                    model: ["todo", "doing", "done"];
                                    current-value <=> root.form-status;
                                }
                            }
                            Field {
                                label: "Priority";
                                ComboBox { model: ["", "A", "B", "C"]; current-value <=> root.form-priority; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Field {
                                label: "Start";
                                LineEdit { placeholder-text: "YYYY-MM-DD"; text <=> root.form-start; }
                            }
                            Field {
                                label: "Repeat";
                                LineEdit { placeholder-text: "for example 1w"; text <=> root.form-repeat; }
                            }
                        }
                        Field {
                            label: "External reference";
                            LineEdit { placeholder-text: "ref:https://example.com/item, gh:owner/repo#1, or URL"; text <=> root.form-external; }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Cancel"; clicked => { root.form-visible = false; } }
                        Button { text: root.form-is-new ? "Add todo" : "Save changes"; primary: true; clicked => { root.save-todo(); } }
                    }
                }
            }
        }

        // ===== Menu-bar dropdown overlays (in-window → open instantly) =====
        // Scrim below the menu bar: clicking anywhere outside closes the menu.
        if root.open-menu != "": TouchArea {
            x: 0; y: 30px; width: root.width; height: root.height - 30px;
            clicked => { root.open-menu = ""; }
        }
        if root.open-menu == "file": MenuPanel {
            x: fileTitle.absolute-position.x;
            y: fileTitle.absolute-position.y + fileTitle.height + 3px;
            width: 232px;
            MenuItem { icon: Icons.plus; label: "New note"; shortcut: "Ctrl+N"; clicked => { root.open-menu = ""; root.new-note(); } }
            MenuItem { icon: Icons.meeting; label: "New meeting note"; clicked => { root.open-menu = ""; root.new-from-template("meeting"); } }
            MenuItem { icon: Icons.person; label: "New 1:1 note"; clicked => { root.open-menu = ""; root.new-from-template("oneonone"); } }
            MenuItem { icon: Icons.decision; label: "New decision note"; clicked => { root.open-menu = ""; root.new-from-template("decision"); } }
            MenuSep {}
            MenuItem { icon: Icons.download; label: "Export note as Markdown"; clicked => { root.open-menu = ""; root.export-note("md"); } }
            MenuItem { icon: Icons.print; label: "Export note as PDF"; clicked => { root.open-menu = ""; root.export-note("pdf"); } }
            MenuSep {}
            MenuItem { icon: Icons.folder; label: "Open vault folder"; clicked => { root.open-menu = ""; root.open-vault-folder(); } }
            MenuItem { icon: Icons.refresh; label: "Reindex from files"; clicked => { root.open-menu = ""; root.reindex(); } }
            MenuItem { icon: Icons.trash2; label: "Open Trash"; clicked => { root.open-menu = ""; root.set-view("trash"); } }
            MenuSep {}
            MenuItem { icon: Icons.power; label: "Exit Noet"; shortcut: "Ctrl+Q"; clicked => { root.open-menu = ""; root.quit(); } }
        }
        if root.open-menu == "help": MenuPanel {
            x: helpTitle.absolute-position.x;
            y: helpTitle.absolute-position.y + helpTitle.height + 3px;
            width: 250px;
            MenuItem { icon: Icons.keyboard; label: "Keyboard shortcuts"; clicked => { root.open-menu = ""; root.shortcuts-open = true; } }
            MenuSep {}
            MenuItem { icon: Icons.info; label: "About Noet " + root.app-version; clicked => { root.open-menu = ""; root.set-view("about"); } }
            MenuItem { icon: Icons.license; label: "Open-source licenses"; clicked => { root.open-menu = ""; root.set-view("about"); } }
            MenuSep {}
            MenuItem { icon: Icons.branch; label: "Noet on GitHub"; clicked => { root.open-menu = ""; root.open-url("https://github.com/marctjones/noet"); } }
            MenuItem { icon: Icons.flag; label: "Report an issue"; clicked => { root.open-menu = ""; root.open-url("https://github.com/marctjones/noet/issues"); } }
            MenuItem { icon: Icons.download; label: "Releases / check for updates"; clicked => { root.open-menu = ""; root.open-url("https://github.com/marctjones/noet/releases"); } }
        }
        if root.open-menu == "edit": MenuPanel {
            x: editTitle.absolute-position.x;
            y: editTitle.absolute-position.y + editTitle.height + 3px;
            width: 210px;
            MenuItem { icon: Icons.cut; label: "Cut"; shortcut: "Ctrl+X"; clicked => { root.open-menu = ""; root.editing = true; root.edit-action = "cut"; } }
            MenuItem { icon: Icons.copy; label: "Copy"; shortcut: "Ctrl+C"; clicked => { root.open-menu = ""; root.editing = true; root.edit-action = "copy"; } }
            MenuItem { icon: Icons.paste; label: "Paste"; shortcut: "Ctrl+V"; clicked => { root.open-menu = ""; root.editing = true; root.edit-action = "paste"; } }
            MenuSep {}
            MenuItem { icon: Icons.selectall; label: "Select all"; shortcut: "Ctrl+A"; clicked => { root.open-menu = ""; root.editing = true; root.edit-action = "selectall"; } }
        }
        if root.open-menu == "note": MenuPanel {
            x: noteTitle.absolute-position.x;
            y: noteTitle.absolute-position.y + noteTitle.height + 3px;
            width: 240px;
            MenuItem { icon: Icons.edit; label: "Edit this note"; clicked => { root.open-menu = ""; root.editing = true; root.set-view("notes"); } }
            MenuItem { icon: Icons.branch; label: "New related note"; clicked => { root.open-menu = ""; root.new-related-note(); } }
            MenuItem { icon: Icons.check; label: "Add todo to note"; clicked => { root.open-menu = ""; root.open-add-todo(); } }
            MenuSep {}
            MenuItem { icon: Icons.swap; label: "Toggle Markdown / Typst"; clicked => { root.open-menu = ""; root.toggle-kind(); } }
            MenuItem { icon: Icons.archive; label: "Archive note"; clicked => { root.open-menu = ""; root.archive-note(true); } }
            MenuItem { icon: Icons.unarchive; label: "Unarchive note"; clicked => { root.open-menu = ""; root.archive-note(false); } }
            MenuSep {}
            MenuItem { icon: Icons.trash2; label: "Delete note (to trash)"; danger: true; clicked => { root.open-menu = ""; root.delete-note(); } }
        }
        if root.open-menu == "view": MenuPanel {
            x: viewTitle.absolute-position.x;
            y: viewTitle.absolute-position.y + viewTitle.height + 3px;
            width: 236px;
            MenuItem { icon: Icons.focus; label: root.focus-mode ? "Exit focus mode" : "Focus mode (hide chrome)"; clicked => { root.open-menu = ""; root.focus-mode = !root.focus-mode; } }
            MenuItem { icon: Icons.panel-left; label: root.nav-collapsed ? "Expand sidebar" : "Collapse sidebar"; clicked => { root.open-menu = ""; root.nav-collapsed = !root.nav-collapsed; } }
            MenuItem { icon: Icons.panel-right; label: root.rail-hidden ? "Show filter rail" : "Hide filter rail"; clicked => { root.open-menu = ""; root.rail-hidden = !root.rail-hidden; } }
            MenuSep {}
            MenuItem { icon: Icons.eye; label: root.show-archived ? "Hide archived notes" : "Show archived notes"; clicked => { root.open-menu = ""; root.set-show-archived(!root.show-archived); } }
            MenuItem { icon: Icons.filter-x; label: "Clear all filters"; clicked => { root.open-menu = ""; root.clear-filters(); } }
            MenuSep {}
            MenuItem { icon: Icons.textsize; label: "Reset zoom"; clicked => { root.open-menu = ""; Z.f = 1.0; } }
            MenuItem { icon: Theme.dark ? Icons.sun : Icons.moon; label: Theme.dark ? "Light theme" : "Dark theme"; clicked => { root.open-menu = ""; Palette.color-scheme = Theme.dark ? ColorScheme.light : ColorScheme.dark; } }
        }

        // ===== Note context menu (right-click note rows / note tabs) =====
        if root.note-context-open: TouchArea {
            x: 0; y: 0; width: root.width; height: root.height;
            clicked => { root.note-context-open = false; }
        }
        if root.note-context-open: MenuPanel {
            x: max(8px, root.note-context-x);
            y: max(8px, root.note-context-y);
            width: 240px;
            MenuItem { icon: Icons.edit; label: "Open"; clicked => { root.note-context-open = false; root.select-note(root.note-context-id); root.set-view("notes"); } }
            MenuItem { icon: Icons.panel-right; label: "Open in split"; clicked => { root.note-context-open = false; root.open-in-split(root.note-context-id); } }
            MenuItem { icon: Icons.star; label: "Pin / unpin"; clicked => { root.note-context-open = false; root.pin-note(root.note-context-id); } }
            MenuItem { icon: Icons.copy; label: "Copy note link"; clicked => { root.note-context-open = false; root.set-clip("[[" + root.note-context-title + "]]"); } }
            MenuSep {}
            MenuItem { icon: Icons.archive; label: "Archive"; clicked => { root.note-context-open = false; root.archive-note-id(root.note-context-id, true); } }
            MenuItem { icon: Icons.unarchive; label: "Unarchive"; clicked => { root.note-context-open = false; root.archive-note-id(root.note-context-id, false); } }
            MenuItem { icon: Icons.x; label: "Close tab"; clicked => { root.note-context-open = false; root.close-tab(root.note-context-id); } }
            MenuSep {}
            MenuItem { icon: Icons.trash2; label: "Delete note (to trash)"; danger: true; clicked => { root.note-context-open = false; root.delete-note-id(root.note-context-id); } }
        }

        // ===== Command palette overlay (Ctrl/⌘+K) =====
        if (root.palette-open): Rectangle {
            background: #00000066;
            // click outside the box closes it
            TouchArea { clicked => { root.palette-open = false; } }
            Rectangle {
                width: min(640px, parent.width - 40px);
                height: min(440px, parent.height - 100px);
                x: (parent.width - self.width) / 2;
                y: 70px;
                background: Theme.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                forward-focus: palinput;
                // swallow clicks so they don't fall through to the backdrop
                TouchArea {}
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    palinput := LineEdit {
                        placeholder-text: "Jump to a note, view, command, or #tag / ▸project…";
                        text <=> root.palette-query;
                        font-size: (15px * Z.f);
                        edited(t) => { root.palette-search(t); }
                        accepted => {
                            if (root.palette-results.length > 0) {
                                root.palette-activate(root.palette-results[0].id);
                                root.palette-open = false;
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for it in root.palette-results: Rectangle {
                            height: 42px;
                            border-radius: 6px;
                            background: pita.has-hover ? Theme.hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 10px;
                                Rectangle {
                                    width: 58px;
                                    Text { text: it.kind; font-size: (9px * Z.f); letter-spacing: 0.5px; color: Theme.text3; vertical-alignment: center; horizontal-alignment: center; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: it.label; font-size: (13px * Z.f); font-weight: 600; color: Theme.text; overflow: elide; }
                                    if (it.hint != ""): Text { text: it.hint; font-size: (10px * Z.f); color: Theme.text3; overflow: elide; }
                                }
                            }
                            pita := TouchArea { clicked => { root.palette-activate(it.id); root.palette-open = false; } }
                        }
                    }
                    Text {
                        text: "Enter opens the top match · Esc/click outside to close";
                        font-size: (9px * Z.f); color: Theme.text3; horizontal-alignment: center;
                    }
                }
            }
        }

        // Quick-capture overlay — a summonable one-line capture into the Inbox
        // (tray "Quick capture", `noet --capture`, or the command palette). The
        // Inbox view has the same field inline; this brings it up from anywhere.
        if (root.quick-capture-open): Rectangle {
            background: #00000066;
            TouchArea { clicked => { root.quick-capture-open = false; } }
            Rectangle {
                width: min(560px, parent.width - 40px);
                height: 128px;
                x: (parent.width - self.width) / 2;
                y: 100px;
                background: Theme.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                forward-focus: capinput;
                TouchArea {}
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: "QUICK CAPTURE → INBOX"; font-size: (10px * Z.f); letter-spacing: 1px; color: Theme.text3; }
                    capinput := LineEdit {
                        placeholder-text: "Capture a thought…  (Enter to save)";
                        text <=> root.capture-input;
                        font-size: (15px * Z.f);
                        accepted => {
                            root.quick-capture(root.capture-input);
                            root.quick-capture-open = false;
                        }
                    }
                    Text {
                        text: "Enter saves to Inbox · click outside to close";
                        font-size: (9px * Z.f); color: Theme.text3; horizontal-alignment: center;
                    }
                }
            }
        }

        // ===== Keyboard-shortcuts cheat sheet =====
        if (root.shortcuts-open): Rectangle {
            background: #00000066;
            TouchArea { clicked => { root.shortcuts-open = false; } }
            Rectangle {
                width: min(520px, parent.width - 40px);
                height: min(440px, parent.height - 100px);
                x: (parent.width - self.width) / 2;
                y: 70px;
                background: Theme.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                TouchArea {}
                VerticalLayout {
                    padding: 16px;
                    spacing: 5px;
                    HorizontalLayout {
                        Text { text: "Keyboard shortcuts"; font-size: (16px * Z.f); font-weight: 700; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
                        CloseX { closed => { root.shortcuts-open = false; } }
                    }
                    Rectangle { height: 6px; }
                    KbRow { keys: "⌘K / Ctrl+K"; desc: "Command palette — go to anything"; }
                    KbRow { keys: "⌘B / Ctrl+B"; desc: "Bold (in editor)"; }
                    KbRow { keys: "⌘I / Ctrl+I"; desc: "Italic"; }
                    KbRow { keys: "⌘E / Ctrl+E"; desc: "Inline code"; }
                    KbRow { keys: "⌘Z / ⌘Y"; desc: "Undo / Redo"; }
                    KbRow { keys: "⌘C / ⌘X / ⌘V"; desc: "Copy / Cut / Paste"; }
                    KbRow { keys: "⌘A"; desc: "Select all (in editor)"; }
                    KbRow { keys: "Enter / Esc"; desc: "Palette: open top match / close overlay"; }
                    KbRow { keys: "⛶ Focus"; desc: "Focus mode — hide chrome (top bar / View menu)"; }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "Note: ⌘ is the Command key on macOS, Ctrl elsewhere."; font-size: (9px * Z.f); color: Theme.text3; }
                }
            }
        }

        // ===== Transient toast (mirrors status-text) =====
        toast-timer := Timer {
            interval: 2600ms;
            running: false;
            triggered => { root.toast-text = ""; self.running = false; }
        }
        if (root.toast-text != ""): Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 26px;
            width: tt.preferred-width + 30px;
            height: 34px;
            background: Theme.text;
            border-radius: 17px;
            opacity: 0.95;
            tt := Text {
                text: root.toast-text;
                color: Theme.bg;
                font-size: (12px * Z.f);
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
