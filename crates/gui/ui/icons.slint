// Custom SVG icon set (monochrome line icons, tinted at use via Image.colorize).
// A neutral cohesive set; per-platform style variants can be added later and
// selected at runtime. Not the proprietary OS sets (Segoe Fluent / SF Symbols).
export global Icons {
    out property <image> today: @image-url("icons/today.svg");
    out property <image> agenda: @image-url("icons/agenda.svg");
    out property <image> calendar: @image-url("icons/calendar.svg");
    out property <image> tasks: @image-url("icons/tasks.svg");
    out property <image> board: @image-url("icons/board.svg");
    out property <image> gantt: @image-url("icons/gantt.svg");
    out property <image> notes: @image-url("icons/notes.svg");
    out property <image> people: @image-url("icons/people.svg");
    out property <image> labels: @image-url("icons/labels.svg");
    out property <image> inbox: @image-url("icons/inbox.svg");
    out property <image> review: @image-url("icons/review.svg");
    out property <image> trash: @image-url("icons/trash.svg");
    out property <image> settings: @image-url("icons/settings.svg");
    out property <image> collapse: @image-url("icons/collapse.svg");
    // Typed-todo kinds (curated Lucide).
    out property <image> kind-do: @image-url("icons/kind-do.svg");
    out property <image> kind-followup: @image-url("icons/kind-followup.svg");
    out property <image> kind-delegated: @image-url("icons/kind-delegated.svg");
    out property <image> kind-todelegate: @image-url("icons/kind-todelegate.svg");
    out property <image> kind-someday: @image-url("icons/kind-someday.svg");
    out property <image> kind-reading: @image-url("icons/kind-reading.svg");
    // Custom Noet app mark.
    out property <image> noet-mark: @image-url("icons/noet-mark.svg");
    // Menu / action icons.
    out property <image> plus: @image-url("icons/plus.svg");
    out property <image> meeting: @image-url("icons/meeting.svg");
    out property <image> person: @image-url("icons/person.svg");
    out property <image> decision: @image-url("icons/decision.svg");
    out property <image> download: @image-url("icons/download.svg");
    out property <image> print: @image-url("icons/print.svg");
    out property <image> folder: @image-url("icons/folder.svg");
    out property <image> refresh: @image-url("icons/refresh.svg");
    out property <image> trash2: @image-url("icons/trash2.svg");
    out property <image> power: @image-url("icons/power.svg");
    out property <image> mail: @image-url("icons/mail.svg");
    out property <image> check: @image-url("icons/check.svg");
    out property <image> swap: @image-url("icons/swap.svg");
    out property <image> info: @image-url("icons/info.svg");
    out property <image> license: @image-url("icons/license.svg");
    out property <image> branch: @image-url("icons/branch.svg");
    out property <image> flag: @image-url("icons/flag.svg");
    out property <image> cut: @image-url("icons/cut.svg");
    out property <image> copy: @image-url("icons/copy.svg");
    out property <image> paste: @image-url("icons/paste.svg");
    out property <image> selectall: @image-url("icons/selectall.svg");
    out property <image> edit: @image-url("icons/edit.svg");
    out property <image> archive: @image-url("icons/archive.svg");
    out property <image> unarchive: @image-url("icons/unarchive.svg");
    out property <image> panel-left: @image-url("icons/panel-left.svg");
    out property <image> panel-right: @image-url("icons/panel-right.svg");
    out property <image> eye: @image-url("icons/eye.svg");
    out property <image> filter-x: @image-url("icons/filter-x.svg");
    out property <image> textsize: @image-url("icons/type.svg");
    out property <image> keyboard: @image-url("icons/keyboard.svg");
    out property <image> focus: @image-url("icons/focus.svg");
    out property <image> sun: @image-url("icons/sun.svg");
    out property <image> moon: @image-url("icons/moon.svg");
    out property <image> x: @image-url("icons/x.svg");
    out property <image> save: @image-url("icons/save.svg");
    out property <image> paperclip: @image-url("icons/paperclip.svg");
    out property <image> star: @image-url("icons/star.svg");
    out property <image> external: @image-url("icons/external.svg");
}
